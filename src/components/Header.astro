---
import { site } from '../data/site';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="D3MOON home">
      <img src="/images/d3moon-logo-blue.png" alt="D3MOON" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation"><span></span><span></span><span></span></button>
    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      {site.nav.map((item) => <a class:list={{ active: current === (item.href.replace(/\/$/, '') || '/') }} href={item.href}>{item.label}</a>)}
      <a class="nav-cta" href="/contact">Get Started <span>→</span></a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const links = nav ? Array.from(nav.querySelectorAll<HTMLAnchorElement>('a')) : [];
  const firstLink = links[0];
  const lastLink = links[links.length - 1];
  const pageContent = document.querySelectorAll<HTMLElement>('body > main, body > footer');
  let lastFocused: HTMLElement | null = null;
  const setMenuState = (open: boolean) => {
    if (open) lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    nav?.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
    pageContent.forEach((element) => { element.inert = open; });
    if (open) window.requestAnimationFrame(() => firstLink?.focus());
    else if (lastFocused) { lastFocused.focus(); lastFocused = null; }
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setMenuState(!open);
  });
  document.addEventListener('keydown', (event) => {
    if (!nav?.classList.contains('open')) return;
    if (event.key === 'Escape') { setMenuState(false); return; }
    if (event.key === 'Tab' && links.length > 0) {
      if (event.shiftKey && document.activeElement === firstLink) { event.preventDefault(); lastLink?.focus(); }
      else if (!event.shiftKey && document.activeElement === lastLink) { event.preventDefault(); firstLink?.focus(); }
    }
  });
  document.addEventListener('click', (event) => {
    if (nav?.classList.contains('open') && event.target instanceof Element && !event.target.closest('.site-header')) setMenuState(false);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    setMenuState(false);
  }));
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,.94); backdrop-filter: blur(18px); border-bottom: 1px solid var(--color-line); }
  .header-inner { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 26px; }
  .brand { display: inline-flex; align-items: center; }
  .brand img { width: 122px; height: 54px; object-fit: contain; object-position: center; }
  .brand-mark { width: 34px; height: 34px; position: relative; display: inline-block; border-radius: 50%; border: 2px solid var(--color-blue); overflow: visible; }
  .brand-mark span { position: absolute; width: 29px; height: 29px; border-radius: 50%; background: white; top: -5px; left: 7px; }
  .brand-mark i { position: absolute; top: -7px; right: -5px; color: var(--color-blue); font-size: 13px; font-style: normal; }
  .site-nav { display: flex; align-items: center; gap: 27px; font-size: .89rem; font-weight: 750; }
  .site-nav a { position: relative; color: #59657d; }
  .site-nav a:not(.nav-cta)::after { content:''; position:absolute; left:0; bottom:-8px; width:100%; height:2px; transform:scaleX(0); transform-origin:center; background:var(--color-blue); transition:transform .2s ease; }
  .site-nav a:hover::after, .site-nav a.active::after { transform:scaleX(1); }
  .nav-cta { display:inline-flex; gap:7px; align-items:center; color:#fff !important; padding:11px 17px; border-radius:999px; background:var(--color-navy); box-shadow:0 8px 18px rgba(33,29,89,.18); }
  .nav-cta:hover { background:var(--color-blue); }
  .menu-toggle { display:none; border:0; background:transparent; padding:8px; }
  .menu-toggle span { display:block; width:24px; height:2px; background:#fff; margin:5px 0; }
  @media(max-width:820px){
    .menu-toggle{display:block;position:relative;z-index:2}.menu-toggle span{background:var(--color-navy)}.site-nav{display:none;position:absolute;left:14px;right:14px;top:calc(100% + 10px);max-height:calc(100vh - 96px);overflow-y:auto;padding:10px;background:#fff;border:1px solid var(--color-line);border-radius:18px;box-shadow:0 18px 45px rgba(5,61,145,.18);flex-direction:column;align-items:stretch;gap:0}.site-nav.open{display:flex}.site-nav a{padding:11px 12px;color:var(--color-ink)!important;border-radius:10px}.site-nav a:hover{background:#f2f8ff}.site-nav a:not(.nav-cta)::after{display:none}.site-nav a.nav-cta{justify-content:center;margin:8px 0 0;color:#fff!important;background:var(--color-navy)}.site-nav a.nav-cta:hover{background:var(--color-blue)}.menu-open{overflow:hidden}
  }
</style>
