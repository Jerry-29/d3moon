---
import { site } from '../data/site';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="D3MOON home">
      <img src="/images/d3moon-logo-white.png" alt="D3MOON" class="brand-logo" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation"><span></span><span></span><span></span></button>
    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      {site.nav.map((item) => <a class:list={{ active: current === (item.href.replace(/\/$/, '') || '/') }} href={item.href}>{item.label}</a>)}
      <a class="nav-cta" href="/contact">Contact Us <span>→</span></a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const links = nav ? Array.from(nav.querySelectorAll<HTMLAnchorElement>('a')) : [];
  const firstLink = links[0];
  const lastLink = links[links.length - 1];
  const pageContent = document.querySelectorAll<HTMLElement>('body > main, body > footer');
  let lastFocused: HTMLElement | null = null;
  const setMenuState = (open: boolean) => {
    if (open) lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    nav?.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
    pageContent.forEach((element) => { element.inert = open; });
    if (open) window.requestAnimationFrame(() => firstLink?.focus());
    else if (lastFocused) { lastFocused.focus(); lastFocused = null; }
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setMenuState(!open);
  });
  document.addEventListener('keydown', (event) => {
    if (!nav?.classList.contains('open')) return;
    if (event.key === 'Escape') { setMenuState(false); return; }
    if (event.key === 'Tab' && links.length > 0) {
      if (event.shiftKey && document.activeElement === firstLink) { event.preventDefault(); lastLink?.focus(); }
      else if (!event.shiftKey && document.activeElement === lastLink) { event.preventDefault(); firstLink?.focus(); }
    }
  });
  document.addEventListener('click', (event) => {
    if (nav?.classList.contains('open') && event.target instanceof Element && !event.target.closest('.site-header')) setMenuState(false);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    setMenuState(false);
  }));
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: #0759b9; border-bottom: 1px solid rgba(255,255,255,0.12); box-shadow: 0 8px 24px rgba(5, 61, 145, 0.18); }
  .header-inner { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 26px; }
  .brand { display: inline-flex; align-items: center; }
  .brand-logo { width: auto; height: 46px; object-fit: contain; object-position: left center; }
  .site-nav { display: flex; align-items: center; gap: 26px; font-size: .88rem; font-weight: 750; }
  .site-nav a { position: relative; color: #dbeaff; transition: color .18s ease; }
  .site-nav a:not(.nav-cta):hover { color: #ffffff; }
  .site-nav a:not(.nav-cta)::after { content:''; position:absolute; left:0; bottom:-8px; width:100%; height:2px; transform:scaleX(0); transform-origin:center; background:#ffffff; transition:transform .2s ease; }
  .site-nav a:hover::after, .site-nav a.active::after { transform:scaleX(1); }
  .site-nav a.active { color: #ffffff; }
  .nav-cta { display:inline-flex; gap:7px; align-items:center; color:#063d91 !important; padding:11px 18px; border-radius:999px; background:#ffffff; box-shadow:0 8px 20px rgba(0,0,0,0.14); transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
  .nav-cta:hover { background:#f2f8ff; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(0,0,0,0.18); }
  .menu-toggle { display:none; border:0; background:transparent; padding:8px; }
  .menu-toggle span { display:block; width:24px; height:2px; background:#ffffff; margin:5px 0; transition: transform .2s ease, opacity .2s ease; }
  @media(max-width:980px){
    .menu-toggle{display:block;position:relative;z-index:2}
    .site-nav{display:none;position:absolute;left:14px;right:14px;top:calc(100% + 10px);max-height:calc(100vh - 96px);overflow-y:auto;padding:14px;background:#0759b9;border:1px solid rgba(255,255,255,0.18);border-radius:18px;box-shadow:0 18px 45px rgba(5,61,145,0.38);flex-direction:column;align-items:stretch;gap:0}
    .site-nav.open{display:flex}
    .site-nav a{padding:13px 14px;color:#ffffff !important;border-radius:10px}
    .site-nav a:hover{background:rgba(255,255,255,0.1)}
    .site-nav a:not(.nav-cta)::after{display:none}
    .site-nav a.nav-cta{justify-content:center;margin:8px 0 0;color:#063d91!important;background:#ffffff}
    .site-nav a.nav-cta:hover{background:#f2f8ff;color:#063d91!important}
    .menu-open{overflow:hidden}
  }
  @media(max-width:420px){
    .brand-logo { height: 38px; }
  }
</style>
