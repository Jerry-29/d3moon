---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  href: string;
  cta: string;
  steps?: string[];
}
const { eyebrow, title, text, href, cta, steps = ['Skills', 'Confidence', 'Growth'] } = Astro.props;
---
<section class="growth-band">
  <div class="container growth-grid">
    <div class="growth-heading">
      <div class="eyebrow">{eyebrow}</div>
      <h2 class="h2" set:html={title}></h2>
    </div>
    <div class="growth-copy">
      <p>{text}</p>
      <a class="btn btn-white" href={href}>{cta} <span>→</span></a>
    </div>
    <div class="growth-visual" aria-hidden="true">
      <div class="growth-line"></div>
      {steps.map((step, index) => <span class:list={{ 'growth-node': true, [`growth-node-${index + 1}`]: true }}>{step}</span>)}
    </div>
  </div>
</section>
<style>
  .growth-band { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(64px, 7vw, 92px); background: linear-gradient(118deg, #041f4d 0%, #063d91 58%, #075fae 100%); color: #fff; }
  .growth-band::before { content: ''; position: absolute; z-index: -1; width: 520px; height: 520px; right: -150px; top: -190px; border: 1px solid rgba(69,215,228,.24); border-radius: 50%; box-shadow: 0 0 0 72px rgba(69,215,228,.035), 0 0 0 144px rgba(69,215,228,.02); }
  .growth-band::after { content: ''; position: absolute; z-index: -1; width: 280px; height: 280px; right: 12%; bottom: -190px; border-radius: 50%; background: radial-gradient(circle, rgba(37,197,208,.2), transparent 68%); }
  .growth-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(240px, .8fr) minmax(270px, .9fr); gap: clamp(30px, 5vw, 72px); align-items: center; min-height: 230px; }
  .growth-heading { max-width: 600px; }
  .growth-band .eyebrow { color: #38c9e1; }
  .growth-heading .h2 { margin: 16px 0 0; max-width: 600px; font-size: clamp(2.2rem, 4vw, 3.55rem); line-height: 1.03; }
  .growth-heading .h2 span { color: #50dce3; }
  .growth-copy { max-width: 370px; position: relative; z-index: 1; }
  .growth-copy p { margin: 0 0 24px; color: #d3e7fb; font-size: 1rem; line-height: 1.65; }
  .growth-copy .btn { box-shadow: 0 12px 24px rgba(1,19,59,.22); }
  .growth-visual { position: relative; width: 100%; max-width: 340px; height: 188px; overflow: hidden; }
  .growth-line { position: absolute; left: 8px; right: 0; top: 105px; height: 1px; background: linear-gradient(90deg, transparent, #4ddce5 12%, #4ddce5 88%, transparent); transform: rotate(-17deg); transform-origin: center; }
  .growth-node { position: absolute; display: grid; place-items: center; min-width: 86px; padding: 8px 12px; border: 1px solid rgba(111,232,239,.65); border-radius: 99px; color: #baf7f5; background: rgba(3,31,76,.78); font-size: .72rem; font-weight: 800; letter-spacing: .04em; }
  .growth-node-1 { left: 0; top: 122px; }
  .growth-node-2 { left: 31%; top: 69px; }
  .growth-node-3 { right: 0; top: 14px; color: #042d6d; background: #36cbd4; border-color: #8df4f2; }
  @media (max-width: 900px) { .growth-grid { grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr); gap: 30px; }.growth-visual { grid-column: 2; grid-row: 1; }.growth-copy { grid-column: 1; grid-row: 2; } }
  @media (max-width: 640px) { .growth-band { padding-block: 58px; }.growth-grid { display: flex; flex-direction: column; align-items: stretch; gap: 25px; }.growth-copy { max-width: 520px; }.growth-visual { height: 132px; }.growth-line { top: 73px; }.growth-node-1 { top: 87px; }.growth-node-2 { top: 48px; }.growth-node-3 { top: 10px; } }
</style>
