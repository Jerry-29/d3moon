---
import type { Job } from '../data/jobs';
interface Props { job: Job; }
const { job } = Astro.props;
---
<article class="job card">
  <div class="job-top"><span class="tag">{job.employmentType}</span><span class="job-id">D3M · {job.id.slice(0,5).toUpperCase()}</span></div>
  <h3>{job.title}</h3>
  <div class="meta"><span><span aria-hidden="true">⌖</span> {job.location}</span><span><span aria-hidden="true">◷</span> {job.experience}</span></div>
  <p>{job.description}</p>
  <div class="skills">{job.skills.map(skill => <span>{skill}</span>)}</div>
  <a class="job-link" href={`/jobs?position=${encodeURIComponent(job.title)}#application`}>Apply for this role <span>→</span></a>
</article>
<style>.job{display:flex;flex-direction:column;min-height:300px;padding:26px;border-top:3px solid transparent;transition:transform .24s ease,border-color .24s ease,box-shadow .24s ease}.job:hover{transform:translateY(-6px);border-color:#b9d8f6;border-top-color:var(--color-cyan);box-shadow:0 24px 60px rgba(13,50,95,.14)}.job-top{display:flex;justify-content:space-between;gap:12px;align-items:center}.tag{font-size:.72rem;font-weight:800;color:var(--color-blue);background:#edf6ff;border-radius:999px;padding:6px 10px}.job-id{font-size:.68rem;color:#94a3b8;font-weight:800;letter-spacing:.08em}.job h3{font-size:1.4rem;line-height:1.15;margin:22px 0 10px;color:var(--color-ink)}.meta{display:flex;flex-wrap:wrap;gap:16px;color:#52647d;font-size:.86rem;font-weight:700}.meta span span{color:var(--color-blue)}.job p{color:var(--color-muted);font-size:.91rem;line-height:1.55;margin:12px 0 0}.skills{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}.skills span{padding:6px 9px;border:1px solid var(--color-line);border-radius:8px;font-size:.76rem;color:#41536d;background:#fbfdff}.job-link{display:flex;align-items:center;justify-content:space-between;gap:7px;margin-top:auto;padding-top:18px;color:var(--color-blue);font-weight:850;font-size:.9rem;border-top:1px solid transparent}.job-link span{transition:transform .2s ease}.job:hover .job-link{border-top-color:#e7eff8}.job:hover .job-link span{transform:translateX(5px)}.job-link:hover{text-decoration:none;color:var(--color-navy)}</style>
