---
import MainLayout from '../layouts/MainLayout.astro';
import { trainingProgrammes } from '../data/site';
---
<MainLayout title="Training & Knowledge Sharing | D3MOON — Founders, Executives, Leaders, Freshers" description="Training programmes by D3MOON: Total HR subject explanation for Founders & Entrepreneurs, Employee to Leader for Senior Executives, Leadership Development for Leaders, and Personal & Workplace Skills for Freshers.">
<main id="main-content">
  <section class="page-hero">
    <div class="container hero-inner">
      <div class="eyebrow light">KNOWLEDGE SHARING & TRAINING</div>
      <h1 class="display">HR capability for every tier — <br /><span>from founders to freshers.</span></h1>
      <p>Targeted programmes designed around the decisions, mindsets and capabilities each audience needs to perform at the next level.</p>
    </div>
  </section>

  <section class="section programmes">
    <div class="container">
      <div class="prog-grid">
        {trainingProgrammes.map((p, i) => (
          <article class={`prog-card prog-${i}`}>
            <div class="prog-head">
              <div class="prog-icon" aria-hidden="true"><span>{p.icon}</span></div>
              <small>{p.audience.toUpperCase()}</small>
            </div>
            <h2 class="prog-title">{p.audience}</h2>
            <div class="prog-block">
              <div class="pb-label">PURPOSE</div>
              <p>{p.purpose}</p>
            </div>
            <div class="prog-block">
              <div class="pb-label">CONTENT COVERAGE</div>
              <p>{p.content}</p>
            </div>
            <div class="prog-foot">
              <span>Programme {String(i + 1).padStart(2, '0')} / {String(trainingProgrammes.length).padStart(2, '0')}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section audience">
    <div class="container">
      <div class="section-heading center">
        <div class="eyebrow">AUDIENCE SNAPSHOT</div>
        <h2 class="h2">The right programme for <span class="gradient-text">the right role.</span></h2>
      </div>
      <div class="audience-grid">
        {[
          {n:'01',a:'Founders & Entrepreneurs',o:'Total HR Subject Explanation',d:'Strategic, executive-level HR literacy for informed decision-making.'},
          {n:'02',a:'Senior Executives',o:'Employee to Leader',d:'Transitioning from senior individual contributor to team leader.'},
          {n:'03',a:'Leaders',o:'Leadership Development',d:'Advanced leadership for complex teams, change and growth.'},
          {n:'04',a:'Freshers',o:'Personal & Workplace Skills',d:'Professional readiness for new hires entering the workplace.'},
        ].map(a => (
          <div class="aud-row">
            <div class="aud-n">{a.n}</div>
            <div class="aud-main">
              <h3>{a.a}</h3>
              <strong>{a.o}</strong>
              <p>{a.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container approach-inner">
      <div>
        <div class="eyebrow light">HOW DELIVERIES ARE RUN</div>
        <h2>Process-led, outcomes-focused, <span>pragmatic in application.</span></h2>
        <p>Programmes are shaped by real HR consulting experience — the theory is always tied to what actually works in growing organisations.</p>
      </div>
      <div class="steps">
        {[
          ['Diagnose','Understand the audience, context and desired outcomes.'],
          ['Design','Shape the curriculum, depth and format to the cohort.'],
          ['Deliver','Expert-led sessions with practice and application built in.'],
          ['Debrief','Clarify follow-through so the learning sticks on the job.'],
        ].map((s,i) => (
          <div class="step">
            <div class="step-n">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h3>{s[0]}</h3>
              <p>{s[1]}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container">
      <div class="cta-inner">
        <div>
          <div class="eyebrow light">BOOK A PROGRAMME</div>
          <h2>Looking for training <span>for your team?</span></h2>
          <p>Share the audience and goals — we'll recommend a programme, format and cadence that fits.</p>
        </div>
        <div class="actions">
          <a class="btn btn-white" href="/contact">Enquire About Training <b>→</b></a>
          <a class="btn cta-outline" href="/startup">Startup Solutions</a>
        </div>
      </div>
    </div>
  </section>
</main>
</MainLayout>

<style>
.page-hero{
  padding:110px 0 100px;
  background:
    radial-gradient(circle at 82% 18%, rgba(167,223,255,.18), transparent 45%),
    linear-gradient(120deg,#063d91,#0759b9 62%,#0a89a7);
  color:#fff;position:relative;overflow:visible;
}
.page-hero::after{
  content:'';position:absolute;width:540px;height:540px;border-radius:50%;left:-200px;top:-260px;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(255,255,255,.018);
}
.hero-inner{position:relative;z-index:1}
.page-hero p{color:#d4e6fb;max-width:700px;font-size:1.08rem;line-height:1.65}
.page-hero .display span{color:#a7dfff}

.programmes{background:#fff}
.prog-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.prog-card{
  border-radius:26px;padding:36px 34px;
  background:#fff;border:1px solid var(--color-line);
  transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;
  position:relative;overflow:hidden;
}
.prog-card::before{
  content:'';position:absolute;inset:auto -10% -55% 40%;height:380px;border-radius:50%;
  pointer-events:none;transition:transform .3s ease;
}
.prog-0::before{background:radial-gradient(circle,rgba(7,89,185,.09),transparent 65%)}
.prog-1::before{background:radial-gradient(circle,rgba(10,137,167,.09),transparent 65%)}
.prog-2::before{background:radial-gradient(circle,rgba(6,61,145,.09),transparent 65%)}
.prog-3::before{background:radial-gradient(circle,rgba(37,197,208,.1),transparent 65%)}
.prog-card:hover{transform:translateY(-5px);box-shadow:0 26px 60px rgba(7,61,145,.1);border-color:#bcdaf6}
.prog-card:hover::before{transform:scale(1.1)}
.prog-head{display:flex;align-items:center;gap:14px;margin-bottom:22px;position:relative;z-index:1}
.prog-icon{
  width:50px;height:50px;border-radius:14px;
  background:linear-gradient(135deg,#063d91,#0a89a7);
  display:grid;place-items:center;color:#fff;font-size:1.3rem;font-weight:900;
  box-shadow:0 12px 26px rgba(7,89,185,.26);
}
.prog-head small{font-size:.65rem;letter-spacing:.2em;color:#0759b9;font-weight:900}
.prog-title{font-size:1.6rem;margin:0 0 20px;letter-spacing:-.03em;color:#0a2d68;position:relative;z-index:1}
.prog-block{margin-bottom:18px;position:relative;z-index:1}
.pb-label{font-size:.65rem;letter-spacing:.18em;color:#0759b9;font-weight:900;margin-bottom:8px}
.prog-block p{margin:0;color:#3a5277;font-size:.95rem;line-height:1.7}
.prog-foot{
  padding-top:18px;margin-top:18px;border-top:1px dashed #d6e3f5;
  display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;
}
.prog-foot span{font-size:.78rem;letter-spacing:.1em;color:#5f7997;font-weight:850}

.audience{background:var(--color-soft)}
.section-heading.center{margin-inline:auto;text-align:center;max-width:780px}
.section-heading.center .lead{margin-inline:auto}
.section-heading .lead{margin-top:0}
.audience-grid{display:grid;gap:12px;margin-top:46px;max-width:980px;margin-inline:auto}
.aud-row{
  display:grid;grid-template-columns:70px 1fr;gap:22px;align-items:start;
  padding:26px 28px;background:#fff;border:1px solid var(--color-line);border-radius:20px;
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
}
.aud-row:hover{transform:translateX(4px);box-shadow:0 18px 42px rgba(7,61,145,.08);border-color:#bcdaf6}
.aud-n{
  width:60px;height:60px;border-radius:16px;
  background:linear-gradient(135deg,#063d91,#0759b9);color:#fff;
  display:grid;place-items:center;font-weight:900;font-size:.86rem;letter-spacing:.08em;
  box-shadow:0 12px 26px rgba(7,89,185,.24);
}
.aud-main h3{font-size:1.22rem;margin:0 0 4px;color:#0a2d68;letter-spacing:-.02em}
.aud-main strong{display:block;color:#0759b9;font-size:.92rem;margin-bottom:8px;font-weight:850}
.aud-main p{margin:0;color:var(--color-muted);font-size:.92rem;line-height:1.6}

.approach{
  margin:0;
  padding:80px 0;
  background:linear-gradient(120deg,#063d91,#0759b9 62%,#0a89a7);color:#fff;
}
.approach-inner{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;align-items:start}
.approach h2{font-size:clamp(1.8rem,3.2vw,2.7rem);line-height:1.1;letter-spacing:-.04em;margin:12px 0 16px;max-width:560px}
.approach h2 span{color:#a7dfff}
.approach-inner > div > p{color:#d4e6fb;max-width:500px;line-height:1.7;margin:0}
.steps{display:grid;gap:12px}
.step{
  display:grid;grid-template-columns:56px 1fr;gap:18px;padding:20px 22px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:18px;
  backdrop-filter:blur(10px);
  transition:background .2s ease,transform .2s ease;
}
.step:hover{background:rgba(255,255,255,.1);transform:translateX(4px)}
.step-n{
  width:52px;height:52px;border-radius:14px;background:#fff;color:#0759b9;
  display:grid;place-items:center;font-weight:900;font-size:.82rem;letter-spacing:.08em;
  box-shadow:0 12px 26px rgba(0,0,0,.14);
}
.step h3{font-size:1.08rem;margin:0 0 5px;color:#fff}
.step p{margin:0;color:#d4e6fb;font-size:.9rem;line-height:1.6}

.final-cta{padding-top:20px;background:#fff}
.cta-inner{
  border-radius:30px;padding:56px 60px;color:#fff;
  background:linear-gradient(110deg,#063d91,#0759b9 58%,#0a89a7);
  display:flex;align-items:center;justify-content:space-between;gap:40px;overflow:visible;position:relative;
}
.cta-inner::after{content:'';position:absolute;width:360px;height:360px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-100px;bottom:-230px}
.cta-inner h2{font-size:clamp(1.8rem,3.6vw,3rem);line-height:1.05;letter-spacing:-.045em;margin:10px 0;position:relative;z-index:1}
.cta-inner h2 span{color:#a7dfff}
.cta-inner p{color:#c9dcee;margin:0;position:relative;z-index:1;max-width:520px}
.actions{display:flex;gap:12px;flex-wrap:wrap;position:relative;z-index:1}
.cta-outline{color:#fff;border-color:rgba(255,255,255,.38);background:transparent}
.cta-outline:hover{border-color:#fff;background:rgba(255,255,255,.08)}

@media(max-width:980px){
  .prog-grid{grid-template-columns:1fr}
  .approach-inner{grid-template-columns:1fr;gap:36px}
  .cta-inner{flex-direction:column;align-items:flex-start;padding:44px 32px}
}
@media(max-width:620px){
  .page-hero{padding:80px 0 72px}
  .prog-card{padding:28px 24px}
  .aud-row{grid-template-columns:56px 1fr;gap:16px;padding:20px 22px}
  .aud-n{width:48px;height:48px;font-size:.78rem;border-radius:12px}
  .cta-inner{padding:38px 26px}
}
</style>
