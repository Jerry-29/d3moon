---
import MainLayout from '../layouts/MainLayout.astro';
import { startupSolutions } from '../data/site';
---
<MainLayout title="Startup Solutions | D3MOON — HR for High-Growth Startups" description="Startup-focused HR by D3MOON: employee relations, engagement, retention, HR foundations, sustainable growth, short-term consulting, documentation, payroll review, policies, engagement implementation, tax and fresher development training.">
<main id="main-content">
  <section class="page-hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="eyebrow light">STARTUP FOCUS</div>
        <h1 class="display">Expert HR solutions — <br /><span>purpose-built for startups.</span></h1>
        <p>{startupSolutions.mission}</p>
      </div>
      <div class="hero-card" aria-hidden="true">
        <div class="hc-head">
          <span class="hc-dot green"></span>
          <span class="hc-dot yellow"></span>
          <span class="hc-dot red"></span>
        </div>
        <div class="hc-body">
          <div class="hc-row"><span class="hc-key">VISION</span><span class="hc-tag">Industry-leading</span></div>
          <div class="hc-title">Startup HR Transformation</div>
          <div class="hc-bar"><div class="hc-bar-fill"></div></div>
          <div class="hc-stats">
            <div><b>Retention</b><span>Healthy</span></div>
            <div><b>Engagement</b><span>Thriving</span></div>
            <div><b>Foundations</b><span>Strong</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section vision">
    <div class="container two-col">
      <div>
        <div class="eyebrow">OUR VISION</div>
        <h2 class="h2">Setting a <span class="gradient-text">new standard of excellence</span> for startup HR.</h2>
        <p class="lead">{startupSolutions.vision}</p>
      </div>
      <div class="commitment">
        <p class="lead">{startupSolutions.commitment}</p>
        <p class="lead">{startupSolutions.empowerment}</p>
      </div>
    </div>
  </section>

  <section class="section pillars">
    <div class="container">
      <div class="section-heading center">
        <div class="eyebrow">WHAT WE DELIVER FOR STARTUPS</div>
        <h2 class="h2">Four pillars of a <span class="gradient-text">thriving startup workplace.</span></h2>
        <p class="lead">A startup's greatest advantage is its people. We help you nurture every layer of the experience.</p>
      </div>
      <div class="pillar-grid">
        {[
          {t:'Employee Relations',d:'Nurture good employee relations across the management team and early workforce.',i:'◈'},
          {t:'Engagement Practices',d:'Implement quality engagement practices that keep early talent connected and motivated.',i:'✦'},
          {t:'Healthy Retention',d:'A mature, intentional approach to retention that reduces avoidable attrition.',i:'❖'},
          {t:'Sustainable Growth',d:'Strengthen HR foundations so culture, systems and people scale with confidence.',i:'◆'},
        ].map((p,i) => (
          <article class="pillar-card" style={`--i:${i*60}ms`}>
            <div class="pill-icon">{p.i}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="short-term-consulting" class="section consulting">
    <div class="container">
      <div class="section-heading center">
        <div class="eyebrow">SHORT-TERM CONSULTING MODEL</div>
        <h2 class="h2">Designed only for <span class="gradient-text">startup companies.</span></h2>
        <p class="lead">A targeted sprint of deliverables that takes the most urgent HR work off your plate and puts sound foundations in place.</p>
      </div>
      <div class="consult-grid">
        {startupSolutions.shortTermConsulting.map((block, i) => (
          <article class="consult-card">
            <div class="consult-head">
              <span class="consult-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{block.title}</h3>
            </div>
            <ul>
              {block.items.map(it => <li><span class="dot"></span>{it}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section founders">
    <div class="container founders-inner">
      <div>
        <div class="eyebrow light">KNOWLEDGE SHARING FOR FOUNDERS</div>
        <h2>HR literacy for founders & entrepreneurs — <span>so you can make confident decisions.</span></h2>
        <p class="purpose">Offers a comprehensive elucidation of diverse HR facets to the executive or senior management tier, empowering them with nuanced insights for informed decision-making and strategic planning.</p>
        <p class="content-line">
          <strong>Subject coverage:</strong> Talent acquisition · Employee engagement · Performance optimization · Legal compliance · Workforce planning — cultivating a holistic understanding of HR dynamics.
        </p>
      </div>
      <a class="btn btn-white" href="/training">See All Training Programmes <b>→</b></a>
    </div>
  </section>

  <section class="section pricing-note">
    <div class="container pricing-inner">
      <div class="p-ic" aria-hidden="true">₹</div>
      <div>
        <div class="eyebrow">ACCESSIBLE FEES</div>
        <h2 class="h2">Reasonable fees ensure startups of all sizes can access <span class="gradient-text">top-tier HR expertise</span> without breaking the bank.</h2>
      </div>
      <a class="btn btn-primary" href="/contact">Get a Startup Quote <b>→</b></a>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container">
      <div class="cta-inner">
        <div>
          <div class="eyebrow light">READY TO SCAPE YOUR STARTUP HR?</div>
          <h2>Propel your startup towards <span>enduring success.</span></h2>
          <p>Tell us about your team size, stage and priorities — we'll tailor the right HR engagement.</p>
        </div>
        <div class="actions">
          <a class="btn btn-white" href="/contact">Schedule a Call <b>→</b></a>
          <a class="btn cta-outline" href="/services">Full Services</a>
        </div>
      </div>
    </div>
  </section>
</main>
</MainLayout>

<style>
.page-hero{
  padding:110px 0 100px;
  background:
    radial-gradient(circle at 18% 80%, rgba(167,223,255,.18), transparent 45%),
    linear-gradient(120deg,#063d91,#0759b9 58%,#0a89a7);
  color:#fff;position:relative;overflow:visible;
}
.page-hero::after{
  content:'';position:absolute;width:540px;height:540px;border-radius:50%;right:-180px;top:-260px;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(255,255,255,.018);
}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:50px;align-items:center;position:relative;z-index:1}
.hero-text p{color:#d4e6fb;max-width:600px;font-size:1.05rem;line-height:1.7}
.page-hero .display span{color:#a7dfff}

.hero-card{
  background:#fff;border-radius:22px;padding:16px;
  box-shadow:0 30px 70px rgba(3,20,48,.25);
  animation:cardFloat 6s ease-in-out infinite;
}
@keyframes cardFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.hc-head{display:flex;gap:7px;padding:4px 6px 10px}
.hc-dot{width:11px;height:11px;border-radius:50%}
.hc-dot.green{background:#3dd598}.hc-dot.yellow{background:#ffbe3d}.hc-dot.red{background:#ff6565}
.hc-body{
  background:linear-gradient(160deg,#f0f7ff,#e8f4f7);
  border-radius:14px;padding:24px;
}
.hc-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.hc-key{font-size:.62rem;letter-spacing:.18em;font-weight:900;color:#0759b9}
.hc-tag{font-size:.7rem;font-weight:850;padding:5px 10px;border-radius:999px;background:#fff;color:#0a89a7;box-shadow:0 6px 14px rgba(10,137,167,.12)}
.hc-title{font-size:1.4rem;line-height:1.15;letter-spacing:-.025em;font-weight:900;color:#0a2d68;margin-bottom:22px}
.hc-bar{height:8px;background:#e0ecff;border-radius:999px;overflow:hidden;margin-bottom:22px}
.hc-bar-fill{width:82%;height:100%;background:linear-gradient(90deg,#0759b9,#25c5d0);border-radius:999px;animation:fillBar 2.2s ease both}
@keyframes fillBar{from{width:0}}
.hc-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.hc-stats>div{background:#fff;padding:12px 10px;border-radius:12px;text-align:center;box-shadow:0 6px 14px rgba(7,89,185,.06)}
.hc-stats b{display:block;font-size:.65rem;letter-spacing:.12em;color:#5f7997;font-weight:850}
.hc-stats span{display:block;font-size:.86rem;font-weight:850;color:#0759b9;margin-top:3px}

.vision{background:#fff}
.two-col{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:start}
.vision .lead{margin-top:14px}
.commitment{padding:30px;border-radius:22px;background:linear-gradient(180deg,#f2f8ff,#f4fbff);border:1px solid #dbe9fb}
.commitment .lead{margin:0 0 14px}
.commitment .lead:last-child{margin:0}

.pillars{background:var(--color-soft)}
.section-heading.center{margin-inline:auto;text-align:center;max-width:780px}
.section-heading.center .lead{margin-inline:auto}
.section-heading .lead{margin-top:0}
.pillar-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:46px}
.pillar-card{
  padding:32px 24px;border-radius:22px;background:#fff;border:1px solid var(--color-line);
  transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;
  animation:rise .55s ease both;animation-delay:var(--i,0);
}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.pillar-card:hover{transform:translateY(-5px);box-shadow:0 24px 55px rgba(7,61,145,.1);border-color:#bcdaf6}
.pill-icon{
  width:50px;height:50px;border-radius:14px;
  background:linear-gradient(135deg,#063d91,#0a89a7);
  color:#fff;display:grid;place-items:center;font-size:1.3rem;font-weight:900;margin-bottom:22px;
  box-shadow:0 14px 28px rgba(7,89,185,.28);
}
.pillar-card h3{font-size:1.1rem;margin:0 0 8px;letter-spacing:-.01em}
.pillar-card p{color:var(--color-muted);font-size:.88rem;line-height:1.6;margin:0}

.consulting{background:#fff}
.consult-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:46px}
.consult-card{
  padding:30px 26px;border-radius:22px;background:linear-gradient(180deg,#fff,#f6faff);
  border:1px solid var(--color-line);
  transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;
  display:flex;flex-direction:column;
}
.consult-card:hover{transform:translateY(-5px);box-shadow:0 24px 55px rgba(7,61,145,.1);border-color:#bcdaf6}
.consult-head{display:flex;align-items:center;gap:14px;margin-bottom:20px}
.consult-index{
  width:44px;height:44px;border-radius:12px;background:#0759b9;color:#fff;
  display:grid;place-items:center;font-weight:900;font-size:.8rem;letter-spacing:.08em;flex-shrink:0;
  box-shadow:0 10px 22px rgba(7,89,185,.24);
}
.consult-head h3{font-size:1.08rem;line-height:1.3;margin:0;letter-spacing:-.01em;color:#0a2d68}
.consult-card ul{list-style:none;padding:0;margin:0;display:grid;gap:10px}
.consult-card li{display:flex;align-items:flex-start;gap:10px;font-size:.9rem;color:#3a5277;font-weight:600;line-height:1.5;padding:10px 12px;background:#fff;border-radius:12px;border:1px solid #e7effc}
.dot{width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0759b9,#25c5d0);flex-shrink:0;margin-top:8px;box-shadow:0 0 0 4px rgba(7,89,185,.1)}

.founders{background:linear-gradient(120deg,#063d91,#0759b9 62%,#0a89a7);color:#fff;padding:80px 0}
.founders-inner{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap}
.founders h2{font-size:clamp(1.8rem,3.4vw,2.8rem);line-height:1.1;letter-spacing:-.04em;margin:12px 0 20px;max-width:720px}
.founders h2 span{color:#a7dfff}
.purpose{color:#dbeaff;font-size:1.02rem;line-height:1.7;max-width:660px;margin:0 0 18px}
.content-line{color:#cde3f9;font-size:.95rem;line-height:1.7;max-width:700px;margin:0}
.content-line strong{color:#fff}

.pricing-note{background:#fff}
.pricing-inner{
  display:grid;grid-template-columns:auto 1fr auto;gap:34px;align-items:center;
  padding:40px 44px;border-radius:26px;background:linear-gradient(135deg,#eaf4ff,#e2f5f7);border:1px solid #d4e6fb;
}
.p-ic{
  width:66px;height:66px;border-radius:18px;background:linear-gradient(135deg,#0759b9,#0a89a7);
  color:#fff;display:grid;place-items:center;font-size:1.7rem;font-weight:900;
  box-shadow:0 16px 32px rgba(7,89,185,.26);
}
.pricing-inner .h2{margin:0;font-size:clamp(1.4rem,2.6vw,2.2rem);letter-spacing:-.03em;line-height:1.2}

.final-cta{padding-top:20px}
.cta-inner{
  border-radius:30px;padding:56px 60px;color:#fff;
  background:linear-gradient(110deg,#063d91,#0759b9 58%,#0a89a7);
  display:flex;align-items:center;justify-content:space-between;gap:40px;overflow:visible;position:relative;
}
.cta-inner::after{content:'';position:absolute;width:360px;height:360px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-100px;bottom:-230px}
.cta-inner h2{font-size:clamp(1.8rem,3.6vw,3rem);line-height:1.05;letter-spacing:-.045em;margin:10px 0;position:relative;z-index:1}
.cta-inner h2 span{color:#a7dfff}
.cta-inner p{color:#c9dcee;margin:0;position:relative;z-index:1;max-width:520px}
.actions{display:flex;gap:12px;flex-wrap:wrap;position:relative;z-index:1}
.cta-outline{color:#fff;border-color:rgba(255,255,255,.38);background:transparent}
.cta-outline:hover{border-color:#fff;background:rgba(255,255,255,.08)}

@media(max-width:980px){
  .hero-grid{grid-template-columns:1fr;gap:30px}
  .hero-card{max-width:500px;margin:0 auto}
  .two-col{grid-template-columns:1fr;gap:36px}
  .pillar-grid{grid-template-columns:1fr 1fr}
  .consult-grid{grid-template-columns:1fr 1fr}
  .pricing-inner{grid-template-columns:auto 1fr}
  .pricing-inner .btn{grid-column:1 / -1;justify-self:start}
  .cta-inner{flex-direction:column;align-items:flex-start;padding:44px 32px}
  .founders-inner{flex-direction:column;align-items:flex-start}
}
@media(max-width:620px){
  .page-hero{padding:80px 0 72px}
  .pillar-grid,.consult-grid{grid-template-columns:1fr}
  .pricing-inner{grid-template-columns:1fr;gap:20px;padding:28px}
  .cta-inner{padding:38px 26px}
}
@media(prefers-reduced-motion:reduce){.hero-card,.hc-bar-fill,.pillar-card{animation:none}}
</style>
