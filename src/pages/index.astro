---
import MainLayout from '../layouts/MainLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site, values, services, outsourceBenefits } from '../data/site';
---
<MainLayout title={`D3MOON | ${site.tagline} — Managed HR Services`} description="Advancing Business through Diligent Managed Services for Human Resources.">
  <main id="main-content">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <div class="hero-kicker">
            <span class="kicker-mark">D3</span>
            <span>MANAGED HR SERVICES · CONSULTING · TRAINING</span>
          </div>
          <h1 class="display">
            Advancing Business through <span>Diligent Managed Services</span> for Human Resources.
          </h1>
          <p>
            Dynamic HR solutions, meticulously tailored to meet the ever-evolving needs of startups, mid-sized, and established companies alike.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/contact">Request a Consultation <b>→</b></a>
            <a class="btn btn-outline" href="/services">Explore Services</a>
          </div>
          <div class="hero-proof">
            <span><strong>STARTUPS</strong> to enterprise</span>
            <span><strong>CERTIFIED</strong> HR experts</span>
            <span><strong>PROCESS</strong>-led delivery</span>
          </div>
        </div>
        <div class="hero-art">
          <div class="hero-visual" aria-hidden="true">
            <div class="hex-main">
              <div class="hex hex-1">P</div>
              <div class="hex hex-2">R</div>
              <div class="hex hex-3">A</div>
              <div class="hex hex-4">C</div>
              <div class="hex hex-5">T</div>
              <div class="hex hex-6">I</div>
              <div class="hex hex-7">C</div>
              <div class="hex-core">
                <div class="core-label">HR</div>
                <div class="core-sublabel">Managed</div>
              </div>
            </div>
          </div>
          <aside class="stat-card">
            <small>OUR DELIVERY FRAMEWORK</small>
            <strong>Process · Practice · Potency</strong>
            <span>A rigorous, client-aligned approach to every engagement.</span>
          </aside>
        </div>
      </div>
    </section>

    <section class="strip">
      <div class="container strip-grid">
        <div><b>Tailored</b><span>HR solutions sized to your organisation</span></div>
        <div><b>Certified</b><span>Qualified HR professionals with industry credentials</span></div>
        <div><b>Compliant</b><span>Up-to-date with regulations and best practices</span></div>
        <div><b>Accessible</b><span>Swift response times and effortless support</span></div>
      </div>
    </section>

    <section class="section about-home">
      <div class="container two-col">
        <div>
          <div class="eyebrow">ABOUT US</div>
          <h2 class="h2">HR partners who build <span class="gradient-text">predictability and efficiency</span> into your team.</h2>
        </div>
        <div>
          <p class="lead">
            We specialise in delivering dynamic HR solutions, meticulously tailored to meet the ever-evolving needs of startups, mid-sized, and established companies alike.
          </p>
          <p class="lead">
            When businesses partner with us, they unlock a world of possibilities. We streamline the complexities of HR team assembly, paving the way for enhanced predictability and efficiency in their operations. Our team of seasoned HR specialists ensures a smooth journey, guiding each team member to excel in their roles with precision and expertise.
          </p>
          <p class="lead">
            Embrace a future where productivity soars, resources are optimised, and operational excellence becomes the norm. Businesses can confidently steer towards unparalleled success with D3MOON by their side.
          </p>
          <a class="text-link" href="/about">Learn More About Us <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="section values-section">
      <div class="container">
        <div class="section-heading center">
          <div class="eyebrow">WHAT SETS US APART</div>
          <h2 class="h2">Our values shape every engagement.</h2>
          <p class="lead">Five commitments that define the quality, integrity and experience of working with D3MOON.</p>
        </div>
        <div class="values-grid">
          {values.map((v, i) => (
            <article class="value-card">
              <div class="value-num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section services-section">
      <div class="container">
        <div class="section-heading center">
          <div class="eyebrow">KEY SERVICES</div>
          <h2 class="h2">Comprehensive HR services — <span class="gradient-text">organised for impact.</span></h2>
          <p class="lead">Strategize, digitize, develop, assess, automate and optimise every dimension of your people function.</p>
        </div>
        <div class="service-grid">
          {services.overview.map((s) => (
            <ServiceCard number={s.number} title={s.title} text={s.text} href={`/services#${s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} />
          ))}
        </div>
        <div class="center-cta">
          <a class="btn btn-outline" href="/services">View the Full Service List <b>→</b></a>
        </div>
      </div>
    </section>

    <section class="section outsource-home">
      <div class="container feature-panel">
        <div class="feature-copy">
          <div class="eyebrow light">WHY OUTSOURCE HR</div>
          <h2 class="h2">Defer cost and risk. <span>Reclaim strategic bandwidth.</span></h2>
          <p>Outsourcing HR affords small companies the opportunity to defer the financial expenditures and inherent risks associated with recruiting a full-time HR team, while consistently upholding compliance standards and comprehensive employee support.</p>
          <ul>
            {outsourceBenefits.slice(0, 5).map(b => <li><strong>{b.title}</strong><span>{b.text}</span></li>)}
          </ul>
          <a class="btn btn-white" href="/why-outsource">All Benefits of Outsourcing <b>→</b></a>
        </div>
        <div class="feature-visual" aria-hidden="true">
          <div class="ring-layers">
            <div class="ring r1"></div>
            <div class="ring r2"></div>
            <div class="ring r3"></div>
          </div>
          <div class="vis-card vis-a">
            <small>FINANCIAL</small><strong>Cost Savings</strong>
          </div>
          <div class="vis-card vis-b">
            <small>COMPLIANCE</small><strong>Reduced Risk</strong>
          </div>
          <div class="vis-card vis-c">
            <small>STRATEGIC</small><strong>Bandwidth Back</strong>
          </div>
        </div>
      </div>
    </section>

<section class="section startup-home">
  <div class="container two-col align-center">
    <div class="startup-visual" aria-hidden="true">
      <div class="launchpad">
        <div class="stage stage-1"><span>Engage</span></div>
        <div class="stage stage-2"><span>Retain</span></div>
        <div class="stage stage-3"><span>Grow</span></div>
        <div class="rocket">
          <div class="rocket-body">
            <div class="rocket-fin rf1"></div>
            <div class="rocket-fin rf2"></div>
            <div class="rocket-window"></div>
          </div>
          <div class="rocket-flame"></div>
        </div>
      </div>
    </div>

    <div>
      <div class="eyebrow">STARTUP-FOCUSED HR</div>
      <h2 class="h2">
        HR foundations that help startups
        <span class="gradient-text">thrive and scale.</span>
      </h2>
      <p class="lead">
        Our mission is to assist startup companies in creating thriving workplaces. We nurture good employee relations, implement quality engagement practices, apply a mature approach to healthy retention, strengthen foundations and fuel sustainable growth.
      </p>
      <div class="check-list">
        <span>✓ Pre-boarding, onboarding & exit documentation</span>
        <span>✓ Payroll management / data review</span>
        <span>✓ Attendance, leave & code of conduct policies</span>
        <span>✓ Employee engagement review & implementation</span>
        <span>✓ Tax explanation & saving suggestions</span>
        <span>✓ Fresher personal development training</span>
      </div>
      <a class="btn btn-primary" href="/startup">Explore Startup Solutions <b>→</b></a>
    </div>
  </div>
</section>


    <section class="section final-cta">
      <div class="container">
        <div class="cta-inner">
          <div>
            <div class="eyebrow light">READY TO SYSTEMATIZE YOUR HR?</div>
            <h2>Let's build <span>operational excellence</span> together.</h2>
            <p>Tell us about your organisation — we'll tailor an HR partnership that matches your stage, goals and values.</p>
          </div>
          <div class="actions">
            <a class="btn btn-white" href="/contact">Get in Touch <b>→</b></a>
            <a class="btn cta-outline" href="/services">Browse Services</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
.hero{
  position:relative;
  background:
    radial-gradient(circle at 18% 25%, rgba(167,223,255,.35), transparent 45%),
    radial-gradient(circle at 82% 70%, rgba(37,197,208,.18), transparent 45%),
    linear-gradient(115deg, #f2f8ff 0%, #e6f2ff 50%, #eefbff 100%);
  overflow:visible;
}
.hero-grid{
  display:grid;
  grid-template-columns:1.05fr .95fr;
  gap:56px;
  align-items:center;
  position:relative;
  z-index:2;
  padding:88px 0 48px;
}
.hero-copy{padding:0}
.hero-kicker{display:inline-flex;flex-wrap:wrap;align-items:center;gap:10px;color:#4f6b90;font-size:.7rem;font-weight:850;letter-spacing:.13em;word-break:break-word}
.hero-kicker span:last-child{line-height:1.3}
.kicker-mark{display:grid;place-items:center;width:28px;height:28px;color:#fff;background:#0759b9;border-radius:9px;font-size:.62rem;letter-spacing:0;box-shadow:0 7px 15px rgba(7,89,185,.25);flex-shrink:0}
.hero h1{max-width:100%;margin:20px 0 18px;font-size:clamp(2.2rem,6vw,4.6rem);line-height:1.02;letter-spacing:-.06em;word-break:break-word;overflow-wrap:break-word}
.hero h1 span{background:linear-gradient(100deg,#0759b9,#0a89a7);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-copy>p{max-width:560px;color:#55708f;font-size:1rem;line-height:1.65;word-break:break-word;overflow-wrap:break-word;margin:0}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.actions .btn{width:auto;max-width:none}
.hero-proof{display:grid;grid-template-columns:repeat(3,max-content);gap:10px 28px;margin-top:28px;color:#5f7997;font-size:.7rem}
.hero-proof span{display:inline-flex;align-items:center;gap:8px;word-break:break-word;overflow-wrap:break-word}
.hero-proof strong{color:#0759b9;font-size:.68rem;letter-spacing:.08em;white-space:nowrap}

.hero-art{
  position:relative;width:100%;max-width:520px;margin:0 auto;
  display:flex;flex-direction:column;gap:20px;
}
.hero-visual{
  position:relative;
  width:100%;
  aspect-ratio:1/1;
  max-width:420px;
  margin:0 auto;
  border-radius:28px;
  background:linear-gradient(160deg,rgba(255,255,255,.6),rgba(220,234,253,.3));
  border:1px solid rgba(220,234,253,.8);
  box-shadow:0 30px 70px rgba(7,61,145,.10);
  display:grid;place-items:center;
}
.hex-main{position:relative;width:78%;max-width:360px;height:auto;aspect-ratio:1/1;margin:0 auto}
.hex{
  position:absolute;width:20%;aspect-ratio:.866/1;
  background:linear-gradient(135deg,#0759b9,#0a89a7);
  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  display:grid;place-items:center;color:#fff;font-weight:900;font-size:clamp(.9rem,1.6vw,1.3rem);
  box-shadow:0 18px 40px rgba(7,89,185,.28);
  animation: hex-float 5.5s ease-in-out infinite;
}
.hex-1{top:0;left:50%;transform:translateX(-50%);animation-delay:0s;background:linear-gradient(135deg,#063d91,#0759b9)}
.hex-2{top:18%;right:13%;animation-delay:.4s;background:linear-gradient(135deg,#0759b9,#0867d4)}
.hex-3{top:55%;right:7.5%;animation-delay:.8s;background:linear-gradient(135deg,#0759b9,#0a89a7)}
.hex-4{bottom:0;left:50%;transform:translateX(-50%);animation-delay:1.2s;background:linear-gradient(135deg,#0a89a7,#25c5d0)}
.hex-5{top:55%;left:7.5%;animation-delay:1.6s;background:linear-gradient(135deg,#0a89a7,#0759b9)}
.hex-6{top:18%;left:13%;animation-delay:2s;background:linear-gradient(135deg,#0867d4,#063d91)}
.hex-7{display:none}
.hex-core{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:40%;aspect-ratio:1/1;border-radius:50%;
  background:#fff;
  border:3px solid #0759b9;
  box-shadow:0 22px 60px rgba(7,89,185,.22), inset 0 0 0 6px rgba(7,89,185,.08);
  display:grid;place-items:center;align-content:center;text-align:center;
  animation: core-pulse 4.2s ease-in-out infinite;
}
.core-label{font-size:clamp(1.4rem,3vw,2.1rem);line-height:1;font-weight:900;color:#0759b9;letter-spacing:-.04em}
.core-sublabel{font-size:clamp(.52rem,1.1vw,.68rem);letter-spacing:.3em;color:#5f7997;font-weight:800;margin-top:6px}
@keyframes hex-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.hex-1{transform-origin:center;animation-name:hex-float-1}
.hex-6{animation-name:hex-float-2}
@keyframes hex-float-1{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-10px)}}
@keyframes hex-float-2{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes hex-float-4{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(10px)}}
.hex-4{transform-origin:center;animation-name:hex-float-4}
@keyframes core-pulse{0%,100%{box-shadow:0 22px 60px rgba(7,89,185,.22),inset 0 0 0 6px rgba(7,89,185,.08)}50%{box-shadow:0 26px 70px rgba(7,89,185,.3),inset 0 0 0 8px rgba(7,89,185,.12)}}

.stat-card{
  position:relative;
  width:100%;
  max-width:420px;
  margin:0 auto;
  left:auto;right:auto;bottom:auto;
  background:rgba(255,255,255,.78);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border:1px solid rgba(220,234,253,.9);
  border-radius:20px;
  padding:20px 22px;
  box-shadow:0 22px 55px rgba(7,61,145,.10);
}
.stat-card::before{
  content:'';position:absolute;top:14px;left:22px;
  width:32px;height:4px;border-radius:999px;background:linear-gradient(90deg,#0759b9,#25c5d0);
}
.stat-card small{font-size:.62rem;letter-spacing:.18em;color:#0759b9;font-weight:850;display:block;margin-top:6px}
.stat-card strong{display:block;font-size:1.25rem;line-height:1.2;margin:10px 0 6px;color:#0a2d68;letter-spacing:-.02em}
.stat-card span{color:#5f7997;font-size:.88rem;line-height:1.5}

.strip{background:#fff;position:relative;z-index:4;margin-top:0}
.strip-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  box-shadow:0 20px 55px rgba(13,50,95,.08);
  border:1px solid var(--color-line);border-radius:0 0 22px 22px;overflow:hidden;
}
.strip-grid>div{padding:26px 28px;border-right:1px solid var(--color-line)}
.strip-grid>div:last-child{border-right:0}
.strip-grid b{display:block;color:#0759b9;font-size:1.4rem;letter-spacing:-.02em;font-weight:850}
.strip-grid span{color:var(--color-muted);font-size:.84rem}

.two-col{display:grid;grid-template-columns:.9fr 1.1fr;gap:80px;align-items:start}
.two-col.align-center{align-items:center}
.about-home{background:#fff}
.about-home .lead{margin:0 0 16px}
.text-link{display:inline-flex;gap:8px;color:var(--color-blue);font-weight:850;margin-top:14px}

.values-section{background:var(--color-soft)}
.section-heading.center{margin-inline:auto;text-align:center;max-width:780px}
.section-heading.center .lead{margin-inline:auto}
.section-heading .lead{margin-top:0}
.values-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:50px;border-top:1px solid var(--color-line);border-bottom:1px solid var(--color-line);background:#fff;border-radius:22px;overflow:hidden;box-shadow:var(--shadow-soft)}
.value-card{padding:32px 24px;border-right:1px solid var(--color-line);position:relative;transition:background .2s ease,transform .2s ease}
.value-card:last-child{border-right:0}
.value-card:hover{background:#f4faff;transform:translateY(-3px)}
.value-num{color:#0759b9;font-weight:900;font-size:.76rem;letter-spacing:.1em}
.value-card h3{font-size:1.06rem;margin:24px 0 10px;line-height:1.25}
.value-card p{color:var(--color-muted);font-size:.86rem;line-height:1.6;margin:0}

.services-section{background:#fff}
.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}
.center-cta{text-align:center;margin-top:44px}

.outsource-home{padding-top:18px}
.feature-panel{
  min-height:540px;border-radius:32px;
  background:linear-gradient(120deg,#063d91,#0759b9 55%,#0a89a7);
  color:#fff;overflow:visible;display:grid;grid-template-columns:1fr 1fr;position:relative;
}
.feature-copy{padding:65px 55px}
.feature-copy .h2{max-width:580px}
.feature-copy .h2 span{color:#a7dfff}
.feature-copy>p{color:#d6e8fb;max-width:540px;line-height:1.65}
.feature-copy ul{list-style:none;padding:0;margin:28px 0;display:grid;gap:12px;color:#e7f1ff;max-width:520px}
.feature-copy li{display:grid;grid-template-columns:170px 1fr;gap:14px;align-items:baseline;padding:14px 16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:14px}
.feature-copy li strong{font-size:.86rem;letter-spacing:.02em;color:#fff}
.feature-copy li span{font-size:.82rem;color:#cfe3fb;line-height:1.5}
.feature-visual{position:relative;min-height:400px}
.ring-layers{position:absolute;inset:0;display:grid;place-items:center}
.ring{position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.18)}
.r1{width:460px;height:460px;box-shadow:inset 0 0 0 50px rgba(167,223,255,.04)}
.r2{width:330px;height:330px;border-style:dashed;border-color:rgba(167,223,255,.28);animation:ring-spin 35s linear infinite}
.r3{width:200px;height:200px;box-shadow:0 0 0 40px rgba(167,223,255,.05)}
@keyframes ring-spin{to{transform:rotate(360deg)}}
.vis-card{
  position:absolute;padding:16px 18px;border-radius:16px;
  background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(10px);
  box-shadow:0 16px 36px rgba(0,0,0,.16);
}
.vis-card small{font-size:.6rem;letter-spacing:.18em;color:#a7dfff;font-weight:850}
.vis-card strong{display:block;font-size:1.05rem;margin-top:6px}
.vis-a{top:80px;left:50px;animation:visFloat 5s ease-in-out infinite}
.vis-b{top:230px;right:40px;animation:visFloat 6s ease-in-out infinite .8s}
.vis-c{bottom:70px;left:90px;animation:visFloat 5.5s ease-in-out infinite 1.4s}
@keyframes visFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

.startup-home{background:linear-gradient(180deg,#fff,#f5faff)}
/* =========================
   STARTUP HR SECTION
   ========================= */

.startup-home {
  background: linear-gradient(180deg, #fff, #f5faff);
}


/* =========================
   STARTUP VISUAL
   ========================= */

.startup-visual {
  width: 100%;
  height: 450px;
  max-height: 80vh;
  border-radius: 28px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #eaf5ff, #e2f4f8);
}

.launchpad {
  position: absolute;
  inset: 0;
}


/* =========================
   STAGE BUTTONS
   ========================= */

.stage {
  position: absolute;
  left: 50%;

  padding: 10px 18px;
  border-radius: 999px;

  font-weight: 850;
  font-size: .8rem;
  letter-spacing: .05em;

  background: #fff;
  border: 2px solid #0759b9;
  color: #0759b9;

  white-space: nowrap;
  box-shadow: 0 10px 26px rgba(7, 89, 185, .15);

  z-index: 5;

  transform: translateX(-50%);
}


/* Bottom */
.stage-1 {
  top: 78%;
}


/* Middle */
.stage-2 {
  top: 50%;

  border-color: #0a89a7;
  color: #0a89a7;

  box-shadow: 0 10px 26px rgba(10, 137, 167, .18);
}


/* Top */
.stage-3 {
  top: 8%;

  border-color: #063d91;
  color: #063d91;

  box-shadow: 0 10px 26px rgba(6, 61, 145, .18);
}


/* =========================
   ROCKET
   ========================= */

.rocket {
  position: absolute;

  left: 50%;
  top: 27%;

  transform: translateX(-50%);

  animation: rocketRise 4.5s ease-in-out infinite;

  z-index: 4;
}

.rocket-body {
  position: relative;

  width: 44px;
  height: 90px;

  background: linear-gradient(
    180deg,
    #fff,
    #eaf4ff
  );

  border: 2px solid #0759b9;

  border-radius: 22px 22px 10px 10px;

  box-shadow:
    0 16px 32px rgba(7, 89, 185, .28);
}


/* =========================
   ROCKET WINDOW
   ========================= */

.rocket-window {
  position: absolute;

  top: 22px;
  left: 50%;

  transform: translateX(-50%);

  width: 18px;
  height: 18px;

  border-radius: 50%;

  background: linear-gradient(
    135deg,
    #25c5d0,
    #0a89a7
  );

  border: 2px solid #fff;

  box-shadow:
    0 0 0 2px #0759b9;
}


/* =========================
   ROCKET FINS
   ========================= */

.rocket-fin {
  position: absolute;

  bottom: -2px;

  width: 14px;
  height: 22px;

  background: #0759b9;
}

.rf1 {
  left: -10px;

  border-radius: 8px 0 0 12px;

  clip-path: polygon(
    100% 0,
    100% 100%,
    0 100%
  );
}

.rf2 {
  right: -10px;

  border-radius: 0 8px 12px 0;

  clip-path: polygon(
    0 0,
    100% 100%,
    0 100%
  );
}


/* =========================
   ROCKET FLAME
   ========================= */

.rocket-flame {
  position: absolute;

  left: 50%;
  top: 100%;

  transform: translateX(-50%);

  margin-top: -4px;

  width: 26px;
  height: 40px;

  background: linear-gradient(
    180deg,
    #ff9d3f,
    #ffd76b 50%,
    transparent
  );

  border-radius: 0 0 50% 50%;

  filter: blur(.2px);

  opacity: .95;

  animation:
    flame 180ms ease-in-out infinite alternate;
}


/* =========================
   ANIMATION
   ========================= */

@keyframes rocketRise {
