---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/site';
---
<MainLayout title="D3MOON | IT Recruitment & Career Training" description="D3MOON connects IT professionals with career opportunities and helps students build the skills to succeed.">
  <main id="main-content">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <div class="hero-kicker"><span>RECRUITMENT · TRAINING · GROWTH</span></div>
          <h1 class="display">The right people<br />make <span>progress.</span></h1>
          <p>We help ambitious teams find exceptional talent, and help capable people find work worth growing into.</p>
          <div class="actions"><a class="btn btn-primary" href="/jobs">Find your next move <b>→</b></a><a class="btn hero-outline" href="/employers">Build your team</a></div>
          <div class="hero-proof"><span><strong>01</strong>Focused on technology</span><span><strong>02</strong>Human in every step</span></div>
        </div>
        <div class="hero-art">
          <div class="hero-photo-wrap">
            <img class="hero-photo" src="/images/hero-team.jpg" width="1200" height="1799" fetchpriority="high" alt="A team collaborating around a table" />
          </div>
          <div class="art-panel"><span class="status-check">↗</span><strong>Good people</strong><small>Good momentum</small></div>
          <div class="hero-tag"><span></span>Human-led. Future-ready.</div>
        </div>
      </div>
    </section>

    <section class="stat-strip"><div class="container stat-grid">
      <div><strong>IT</strong><span>Industry-focused expertise</span></div>
      <div><strong>360°</strong><span>Career & hiring support</span></div>
      <div><strong>1:1</strong><span>Personalized approach</span></div>
      <div><strong>∞</strong><span>Room to grow</span></div>
    </div></section>

    <section class="section about-home"><div class="container two-col">
      <div><div class="eyebrow">WHO WE ARE</div><h2 class="h2">Where talent meets <span class="gradient-text">opportunity.</span></h2></div>
      <div><p class="lead">D3MOON is a recruitment and training firm specializing in IT placements and career growth training for students. We combine personalized service with industry expertise to create meaningful connections.</p><p class="lead">Our focus is simple: understand people, understand businesses and create the right path between the two.</p><a class="text-link" href="/about">Discover D3MOON <span>→</span></a></div>
    </div></section>

    <section class="section services-section"><div class="container"><SectionTitle eyebrow="WHAT WE DO" title="Solutions built around people." text="From finding the right talent to building career-ready skills, D3MOON supports the journey on both sides of the opportunity." align="center"/><div class="service-grid">{services.map((s) => <ServiceCard number={s.number} title={s.title} text={s.text} href={s.title === 'IT Recruitment' || s.title === 'Talent Solutions' ? '/employers' : '/jobs'} />)}</div></div></section>

    <section class="section employer-home"><div class="container feature-panel"><div class="feature-copy"><div class="eyebrow light">FOR EMPLOYERS</div><h2 class="h2">Build your team with the <span>right talent.</span></h2><p>Tell us what you need. We help you connect with skilled IT professionals through a focused, personalized recruitment approach.</p><ul><li>Talent sourcing & screening</li><li>Technical recruitment support</li><li>Customized hiring solutions</li></ul><a class="btn btn-white" href="/employers">Hire Talent <b>→</b></a></div><div class="feature-visual"><div class="circle-lines"></div><div class="visual-card"><small>THE RIGHT FIT</small><strong>People<br />who <em>move</em><br />business forward.</strong></div></div></div></section>

    <section class="section candidate-home"><div class="container candidate-grid"><div class="candidate-art"><div class="mini-moon"></div><span>YOUR NEXT<br /><b>CHAPTER</b></span></div><div><div class="eyebrow">FOR JOB SEEKERS & STUDENTS</div><h2 class="h2">Your next opportunity <span class="gradient-text">starts here.</span></h2><p class="lead">Explore opportunities, strengthen your skills and get practical guidance for your career journey in technology.</p><div class="check-list"><span>✓ IT placement opportunities</span><span>✓ Career-focused training</span><span>✓ Practical career guidance</span></div><a class="btn btn-primary" href="/jobs">Explore Jobs <b>→</b></a></div></div></section>

    <section class="section why-section"><div class="container"><SectionTitle eyebrow="WHY D3MOON" title="A better way to move forward." align="center"/><div class="why-grid"><div><b>01</b><h3>Industry Expertise</h3><p>Focused on the IT ecosystem and the skills, roles and expectations within it.</p></div><div><b>02</b><h3>Personalized Approach</h3><p>We listen first and shape our support around the individual or organization.</p></div><div><b>03</b><h3>Quality Connections</h3><p>We work toward the right fit rather than simply filling a position.</p></div><div><b>04</b><h3>Long-Term Growth</h3><p>Our goal is meaningful progress for candidates, students and employers.</p></div></div></div></section>

    <section class="section process-section"><div class="container"><SectionTitle eyebrow="OUR APPROACH" title="Understand. Guide. Grow." text="A simple philosophy that keeps the experience focused and human." align="center"/><div class="process"><div><span>01</span><h3>Understand</h3><p>We listen to your goals, skills and requirements.</p></div><div><span>02</span><h3>Guide</h3><p>We connect you with the right opportunity or path.</p></div><div><span>03</span><h3>Prepare</h3><p>We help build the skills and confidence to move forward.</p></div><div><span>04</span><h3>Grow</h3><p>We stay focused on the outcome beyond the first step.</p></div></div></div></section>

    <section class="section final-cta"><div class="container"><div class="cta-inner"><div><div class="eyebrow light">READY FOR YOUR NEXT STEP?</div><h2>Let's create a <span>better future</span> together.</h2><p>Whether you're hiring or building your career, start the conversation with D3MOON.</p></div><div class="actions"><a class="btn btn-white" href="/contact">Get in Touch <b>→</b></a><a class="btn cta-outline" href="/jobs">Explore Jobs</a></div></div></div></section>
  </main>
</MainLayout>
<style>
.hero{position:relative;min-height:650px;background:linear-gradient(125deg,#061735 0%,#0b3976 47%,#075e9e 78%,#0a8c9b 100%);color:#fff;overflow:hidden}.hero::after{content:'';position:absolute;inset:auto -10% -50% 35%;height:600px;background:radial-gradient(circle,rgba(45,215,226,.25),transparent 65%);pointer-events:none}.hero-grid{min-height:620px;display:grid;grid-template-columns:1.04fr .96fr;gap:20px;align-items:center;position:relative;z-index:2}.hero-copy{padding:50px 0}.hero .eyebrow.light,.light{color:#a9eff8}.hero h1{max-width:720px}.hero h1 span{color:#56dded}.hero-copy>p{font-size:1.08rem;color:#d9e8fb;max-width:630px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.hero-outline{color:#fff;border-color:rgba(255,255,255,.45);background:rgba(255,255,255,.04)}.hero-outline:hover{background:rgba(255,255,255,.1);border-color:#fff}.hero-note{display:flex;align-items:center;gap:10px;margin-top:38px;color:#a9bfdc;font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.hero-note i{width:4px;height:4px;border-radius:50%;background:#48d7e4}.hero-art{height:530px;position:relative}.moon{position:absolute;width:330px;height:330px;border-radius:50%;right:65px;top:85px;background:radial-gradient(circle at 35% 35%,#fff 0,#d8fbff 45%,#65ddea 100%);box-shadow:0 0 100px rgba(107,237,246,.42)}.moon>div{position:absolute;width:335px;height:335px;border-radius:50%;background:#0a4b88;left:78px;top:-20px}.orbit{position:absolute;border:1px solid rgba(164,236,255,.22);border-radius:50%;transform:rotate(-23deg)}.orbit-a{width:510px;height:220px;right:-10px;top:140px}.orbit-b{width:430px;height:170px;right:45px;top:195px}.spark{position:absolute;color:#fff;text-shadow:0 0 18px #b8faff}.spark-a{right:95px;top:55px;font-size:25px}.spark-b{left:80px;bottom:115px;color:#6fe8f1}.art-panel{position:absolute;left:10px;bottom:58px;background:rgba(3,20,48,.62);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(15px);border-radius:20px;padding:20px 24px;width:210px;box-shadow:0 20px 50px rgba(0,0,0,.16)}.art-panel span{font-size:.65rem;letter-spacing:.16em;color:#87dce8;font-weight:800}.art-panel strong{display:block;font-size:1.7rem;line-height:1.05;margin:9px 0}.art-panel em{font-style:normal;color:#60deeb}.art-panel small{color:#9bb3d1}.hero-stars{position:absolute;right:10%;top:22%;color:rgba(255,255,255,.65);letter-spacing:16px;font-size:11px}.hero-bottom{position:absolute;bottom:0;left:0;right:0;border-top:1px solid rgba(255,255,255,.13);z-index:3}.hero-bottom-inner{height:55px;display:flex;align-items:center;justify-content:space-between;color:#aac0db;font-size:.78rem}.scroll{color:#d5e8fa}.stat-strip{margin-top:-1px;background:#fff;position:relative;z-index:4}.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);box-shadow:0 18px 45px rgba(13,50,95,.08);border:1px solid var(--color-line);border-radius:0 0 20px 20px;overflow:hidden}.stat-grid>div{padding:25px 27px;border-right:1px solid var(--color-line)}.stat-grid>div:last-child{border-right:0}.stat-grid strong{display:block;font-size:1.8rem;letter-spacing:-.04em}.stat-grid span{color:var(--color-muted);font-size:.82rem}.two-col{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px;align-items:start}.about-home{background:#fff}.about-home .lead{margin:0 0 15px}.text-link{display:inline-flex;gap:8px;color:var(--color-blue);font-weight:850;margin-top:12px}.services-section{background:var(--color-soft)}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:45px}.employer-home{padding-top:20px}.feature-panel{min-height:510px;border-radius:32px;background:linear-gradient(120deg,#071a38,#0a3771 58%,#0c83a1);color:#fff;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;position:relative}.feature-copy{padding:65px 55px}.feature-copy .h2{max-width:580px}.feature-copy .h2 span{color:#5ce1ed}.feature-copy>p{color:#c9dbee;max-width:540px}.feature-copy ul{list-style:none;padding:0;margin:25px 0;display:grid;gap:10px;color:#dceafa}.feature-copy li::before{content:'✓';display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;background:rgba(91,224,237,.13);color:#62e1ed;margin-right:10px}.feature-visual{position:relative;min-height:400px}.circle-lines{position:absolute;width:440px;height:440px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-120px;top:35px;box-shadow:0 0 0 65px rgba(255,255,255,.025),0 0 0 130px rgba(255,255,255,.018)}.visual-card{position:absolute;right:65px;top:105px;width:230px;padding:22px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);backdrop-filter:blur(12px);border-radius:18px}.visual-card small{font-size:.62rem;letter-spacing:.15em;color:#6fe5ef;font-weight:800}.visual-card strong{display:block;font-size:1.65rem;line-height:1.12;margin-top:12px}.visual-card em{color:#6de5ef;font-style:normal}.candidate-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:85px;align-items:center}.candidate-art{height:370px;border-radius:30px;background:linear-gradient(145deg,#eaf8ff,#ccecf9);position:relative;overflow:hidden;display:flex;align-items:flex-end;padding:35px;color:#123b68;font-weight:700;font-size:1.2rem}.candidate-art::after{content:'';position:absolute;width:420px;height:420px;border-radius:50%;right:-180px;top:-180px;background:radial-gradient(circle,#2cc8d7,#0870d9 62%,#07376e)}.candidate-art span{position:relative;z-index:2}.candidate-art b{color:var(--color-blue)}.mini-moon{position:absolute;width:150px;height:150px;border-radius:50%;right:70px;top:70px;background:#fff;z-index:2;box-shadow:0 0 60px #fff8}.mini-moon::after{content:'';position:absolute;width:155px;height:155px;border-radius:50%;background:#1164a7;left:38px;top:-12px}.check-list{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:25px 0;color:#41536d;font-weight:700;font-size:.88rem}.why-section{background:#f7fbff}.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:45px;border-top:1px solid var(--color-line);border-bottom:1px solid var(--color-line)}.why-grid>div{padding:30px 25px;border-right:1px solid var(--color-line)}.why-grid>div:last-child{border-right:0}.why-grid b{color:var(--color-blue);font-size:.78rem}.why-grid h3{font-size:1.1rem;margin:22px 0 8px}.why-grid p{color:var(--color-muted);font-size:.88rem;margin:0}.process{display:grid;grid-template-columns:repeat(4,1fr);margin-top:45px;position:relative}.process::before{content:'';position:absolute;left:11%;right:11%;top:22px;border-top:1px dashed #9ec4e7}.process>div{position:relative;text-align:center;padding:0 20px}.process span{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;margin:0 auto 18px;background:var(--color-blue);color:#fff;font-weight:900;border:5px solid #e8f3ff}.process h3{font-size:1rem}.process p{font-size:.84rem;color:var(--color-muted)}.final-cta{padding-top:30px}.cta-inner{border-radius:30px;padding:55px 60px;color:#fff;background:linear-gradient(110deg,#071a38,#0a4d91 62%,#0b93a2);display:flex;align-items:center;justify-content:space-between;gap:30px;overflow:hidden;position:relative}.cta-inner::after{content:'';position:absolute;width:350px;height:350px;border:1px solid rgba(255,255,255,.13);border-radius:50%;right:-80px;bottom:-220px}.cta-inner h2{font-size:clamp(2rem,4vw,3.2rem);line-height:1.05;letter-spacing:-.045em;margin:10px 0}.cta-inner h2 span{color:#65e0eb}.cta-inner p{color:#c8d9eb;margin:0}.cta-outline{color:#fff;border-color:rgba(255,255,255,.35);background:transparent}.cta-outline:hover{border-color:#fff;background:rgba(255,255,255,.08)}
@media(max-width:900px){.hero-grid,.feature-panel{grid-template-columns:1fr}.hero-art{height:420px}.hero-copy{padding-bottom:15px}.service-grid{grid-template-columns:1fr 1fr}.why-grid{grid-template-columns:1fr 1fr}.why-grid>div:nth-child(2){border-right:0}.two-col,.candidate-grid{grid-template-columns:1fr;gap:35px}.candidate-art{height:300px}.process{grid-template-columns:1fr 1fr;gap:30px}.process::before{display:none}.feature-visual{min-height:300px}.cta-inner{flex-direction:column;align-items:flex-start}}
@media(max-width:560px){.hero{min-height:760px}.hero-grid{min-height:720px}.hero-art{height:300px}.moon{width:210px;height:210px;right:35px;top:20px}.moon>div{width:215px;height:215px;left:50px}.art-panel{left:0;bottom:10px}.hero-note{flex-wrap:wrap}.stat-grid{grid-template-columns:1fr 1fr}.stat-grid>div{border-bottom:1px solid var(--color-line)}.stat-grid>div:nth-child(2){border-right:0}.stat-grid>div:nth-child(3){border-bottom:0}.stat-grid>div:nth-child(4){border-bottom:0;border-right:0}.service-grid,.why-grid,.process{grid-template-columns:1fr}.why-grid>div{border-right:0;border-bottom:1px solid var(--color-line)}.why-grid>div:last-child{border-bottom:0}.check-list{grid-template-columns:1fr}.feature-copy{padding:42px 28px}.feature-visual{display:none}.cta-inner{padding:40px 28px}}

/* Reference-inspired home hero */
.hero { min-height: 620px; color: var(--color-ink); background: radial-gradient(circle at 31% 38%, rgba(184, 222, 255, .66), transparent 33%), radial-gradient(circle at 71% 34%, rgba(201, 247, 250, .7), transparent 30%), #f7fbff; }
.hero::after { inset: 0; width: 100%; height: 100%; background: linear-gradient(90deg, transparent 15%, rgba(255,255,255,.28), transparent 85%); opacity: .5; }
.hero-grid { min-height: 620px; grid-template-columns: .94fr 1.06fr; gap: 45px; }
.hero-copy { padding: 80px 0 75px; position: relative; z-index: 2; }
.hero-kicker { display: inline-flex; align-items: center; gap: 10px; color: #747b91; font-size: .7rem; font-weight: 850; letter-spacing: .13em; }
.kicker-mark { display: grid; place-items: center; width: 28px; height: 28px; color: #fff; background: var(--color-navy); border-radius: 9px; font-size: .62rem; letter-spacing: 0; box-shadow: 0 7px 15px rgba(33,29,89,.18); }
.hero h1 { max-width: 620px; margin: 24px 0 16px; font-size: clamp(3.15rem, 5.5vw, 5rem); line-height: 1.02; letter-spacing: -.06em; }
.hero h1 span { color: var(--color-blue); background: linear-gradient(100deg, #075dcc, #18adcb); -webkit-background-clip: text; background-clip: text; }
.hero-copy>p { max-width: 535px; color: #6b7e99; font-size: 1rem; line-height: 1.55; }
.hero .actions { margin-top: 25px; }
.hero .btn-primary { background: var(--color-navy); box-shadow: 0 12px 22px rgba(33,29,89,.18); }
.hero-outline { color: var(--color-ink); background: rgba(255,255,255,.8); border-color: #dfe2ec; }
.hero-outline:hover { background: #fff; border-color: #c3c6db; }
.hero-proof { display: flex; gap: 28px; margin-top: 34px; color: #73809a; font-size: .72rem; }
.hero-proof span { display: inline-flex; align-items: center; gap: 8px; }
.hero-proof strong { color: var(--color-cyan); font-size: .68rem; letter-spacing: .08em; }
.hero-art { height: 480px; align-self: center; position: relative; z-index: 2; }
.hero-photo-wrap { position: absolute; inset: 35px 5px 20px 0; overflow: hidden; border: 4px solid #fff; border-radius: 20px; box-shadow: 0 22px 45px rgba(72, 85, 164, .2); transform: rotate(1.8deg); transition: transform .6s cubic-bezier(.2,.8,.2,1), box-shadow .6s ease; background: #cbd2d2; }
.hero-photo-wrap:hover { transform: rotate(-1.8deg) translateY(-5px); box-shadow: 0 28px 55px rgba(72, 85, 164, .27); }
.hero-photo { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.art-panel { left: -25px; bottom: 12px; display: grid; grid-template-columns: 34px 1fr; grid-template-rows: 1fr 1fr; align-items: center; gap: 0 10px; min-width: 150px; padding: 12px 18px 12px 12px; color: var(--color-ink); background: rgba(255,255,255,.97); border: 0; border-radius: 12px; box-shadow: 0 14px 24px rgba(33,29,89,.16); backdrop-filter: none; animation: badge-float 4.2s ease-in-out infinite; }
.art-panel .status-check { grid-row: 1 / 3; display: grid; place-items: center; width: 32px; height: 32px; color: #2eae71; background: #ddfae9; border-radius: 50%; font-size: 1.1rem; font-weight: 800; }
.art-panel strong { grid-column: 2; font-size: .74rem; line-height: 1.05; white-space: nowrap; }
.art-panel small { grid-column: 2; color: #7a879e; font-size: .65rem; line-height: 1; }
.hero-tag { position: absolute; top: 8px; right: -17px; display: inline-flex; align-items: center; gap: 8px; padding: 9px 13px; color: var(--color-ink); background: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.9); border-radius: 99px; box-shadow: 0 8px 20px rgba(33,29,89,.08); font-size: .7rem; font-weight: 800; transform: rotate(5deg); }
.hero-tag span { width: 7px; height: 7px; background: var(--color-cyan); border-radius: 50%; }
@keyframes badge-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
@media(max-width:900px){.hero{min-height:unset}.hero-grid{min-height:unset;grid-template-columns:1fr;gap:0}.hero-copy{padding:70px 0 20px}.hero-art{height:430px;max-width:650px;width:100%;margin:0 auto}.hero-photo-wrap{inset:20px 5px 25px 0}.art-panel{left:0;bottom:16px}.hero-tag{right:0}}
@media(max-width:560px){.hero-copy{padding:48px 0 10px}.hero h1{font-size:clamp(2.7rem,13vw,4rem)}.hero-art{height:320px}.hero-photo-wrap{inset:15px 4px 20px 0;border-radius:15px}.art-panel{left:-4px;bottom:4px}.hero-tag{top:0;right:-3px;font-size:.62rem}.hero-proof{flex-direction:column;gap:8px;margin-top:25px}.hero .actions{margin-top:22px}}
@media(prefers-reduced-motion:reduce){.art-panel{animation:none}.hero-photo-wrap,.hero-photo-wrap:hover{transition:none;transform:rotate(1.8deg)}}
</style>
