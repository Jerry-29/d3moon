---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="D3MOON for Employers | IT Recruitment Solutions">
<main id="main-content">
<section class="page-hero"><div class="container"><div class="eyebrow light">FOR EMPLOYERS</div><h1 class="display">Build your team with the<br /><span>right talent.</span></h1><p>Focused IT recruitment support for organizations looking to connect with capable professionals.</p></div></section>
<section class="section"><div class="container"><div class="eyebrow">WHAT WE SUPPORT</div><h2 class="h2">Hiring solutions that stay <span class="gradient-text">focused.</span></h2><div class="employer-services"><article><b>01</b><h3>IT Talent Acquisition</h3><p>Connect with technology professionals aligned with your requirements.</p></article><article><b>02</b><h3>Technical Recruitment</h3><p>Role-focused sourcing and conversations for technology positions.</p></article><article><b>03</b><h3>Candidate Screening</h3><p>Support in narrowing the search toward relevant, qualified profiles.</p></article><article><b>04</b><h3>Bulk Hiring</h3><p>Structured support for multiple technology hiring requirements.</p></article><article><b>05</b><h3>Recruitment Support</h3><p>Practical assistance across the hiring journey.</p></article><article><b>06</b><h3>Customized Solutions</h3><p>A personalized approach shaped around your business requirement.</p></article></div></div></section>
<section class="section process-band"><div class="container"><div class="eyebrow light">HIRING JOURNEY</div><h2 class="h2">From requirement to <span>right fit.</span></h2><div class="employer-process"><div><span>01</span><strong>Tell us</strong><small>Your requirement</small></div><div><span>02</span><strong>Search</strong><small>Relevant talent</small></div><div><span>03</span><strong>Screen</strong><small>Profiles & fit</small></div><div><span>04</span><strong>Shortlist</strong><small>Strong matches</small></div><div><span>05</span><strong>Interview</strong><small>Connect & assess</small></div><div><span>06</span><strong>Hire</strong><small>Move forward</small></div></div></div></section>
<section class="section form-section"><div class="container form-grid"><div><div class="eyebrow">START HIRING</div><h2 class="h2">Tell us what you're <span class="gradient-text">looking for.</span></h2><p class="lead">Share the role and requirements. This form is ready to connect to your preferred email/API endpoint.</p><div class="form-aside"><span>✓</span><div><strong>Clear requirements</strong><p>Role, skills, experience and location in one place.</p></div></div><div class="form-aside"><span>✓</span><div><strong>Human support</strong><p>A focused conversation around your hiring need.</p></div></div></div><form class="card form" data-form="employer" data-email="info@d3moon.com"><div class="form-row"><label>Company Name *<input name="companyName" required /></label><label>Contact Person *<input name="contactPerson" required /></label></div><div class="form-row"><label>Business Email *<input type="email" name="email" required /></label><label>Phone *<input name="phone" required /></label></div><div class="form-row"><label>Job Title *<input name="jobTitle" required /></label><label>Number of Positions<input type="number" min="1" name="positions" /></label></div><div class="form-row"><label>Required Skills<input name="skills" /></label><label>Experience Required<input name="experience" /></label></div><div class="form-row"><label>Location<input name="location" /></label><label>Employment Type<select name="employmentType"><option value="">Select</option><option>Full-time</option><option>Part-time</option><option>Contract</option><option>Other</option></select></label></div><label>Additional Requirements<textarea name="requirements"></textarea></label><button class="btn btn-primary" type="submit">Submit Hiring Requirement <span>→</span></button><p class="form-status" aria-live="polite"></p></form></div></section>
</main>
</MainLayout>
<script>
  const formEmail = (import.meta.env.PUBLIC_FORM_EMAIL as string | undefined) || 'pasific.coc@gmail.com';
  const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined) || `https://formsubmit.co/ajax/${encodeURIComponent(formEmail)}`;
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const contactEmail = formEmail;
    const status = form.querySelector<HTMLElement>('.form-status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (!button) return;
      const original = button.innerHTML; button.disabled = true; button.textContent = 'Sending…';
      try {
        const payload = new FormData(form);
        payload.append('_subject', `D3MOON hiring request from ${payload.get('contactPerson') || 'new employer'}: ${payload.get('jobTitle') || 'New role'}`);
        payload.append('_replyto', String(payload.get('email') || ''));
        payload.append('_honey', '');
        payload.append('_template', 'table');
        const response = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: payload });
        if (!response.ok) throw new Error('request-failed');
        const result = await response.json().catch(() => null);
        if (result?.success === false || result?.success === 'false') throw new Error(result?.message || 'service-rejected');
        form.reset(); if (status) { status.classList.remove('error'); status.textContent = 'Thank you! Your hiring requirement has been sent successfully.'; }
      } catch (error) { if (status) { status.classList.add('error'); status.textContent = String(error).includes('Activation') ? 'Please activate the FormSubmit email link sent to ' + contactEmail + ', then submit again.' : 'We could not send your requirement. Please try again or email ' + contactEmail + '.'; } }
      finally { button.disabled = false; button.innerHTML = original; }
    });
  });
</script>
<style>
.employer-services{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:42px}.employer-services article{padding:30px;border:1px solid var(--color-line);border-radius:20px;background:#fff;box-shadow:var(--shadow-soft)}.employer-services b{color:var(--color-blue);font-size:.75rem}.employer-services h3{margin:22px 0 8px}.employer-services p{margin:0;color:var(--color-muted);font-size:.9rem}.process-band{background:linear-gradient(120deg,#071a38,#0a4b88);color:#fff}.process-band .h2 span{color:#62dfeb}.employer-process{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-top:45px}.employer-process>div{padding:20px 10px;border-top:1px solid rgba(255,255,255,.2)}.employer-process span{display:block;color:#62dfeb;font-weight:900;font-size:.75rem}.employer-process strong{display:block;margin:13px 0 3px}.employer-process small{color:#9eb4ce}.form-section{background:#f6faff}.form-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:75px;align-items:start}.form-aside{display:flex;gap:13px;margin-top:25px}.form-aside>span{width:30px;height:30px;flex:none;border-radius:50%;display:grid;place-items:center;background:#e6f5ff;color:var(--color-blue);font-weight:900}.form-aside strong{font-size:.95rem}.form-aside p{margin:2px 0;color:var(--color-muted);font-size:.85rem}.form{padding:30px;display:grid;gap:17px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-status{margin:0;color:var(--color-blue);font-size:.85rem;font-weight:700}.form-status.error{color:#b42318}@media(max-width:800px){.employer-services{grid-template-columns:1fr 1fr}.employer-process{grid-template-columns:repeat(3,1fr)}.form-grid{grid-template-columns:1fr;gap:35px}}@media(max-width:560px){.employer-services,.employer-process,.form-row{grid-template-columns:1fr}}
</style>
<style>
  .employer-services article { position: relative; min-height: 232px; overflow: hidden; border-top: 3px solid transparent; transition: transform .24s ease, border-color .24s ease, box-shadow .24s ease; }
  .employer-services article::after { content: '↗'; position: absolute; top: 24px; right: 24px; display: grid; place-items: center; width: 34px; height: 34px; color: var(--color-blue); background: #edf6ff; border-radius: 50%; font-weight: 900; transition: color .2s ease, background .2s ease, transform .2s ease; }
  .employer-services article:hover { transform: translateY(-6px); border-color: #b9d8f6; border-top-color: var(--color-cyan); box-shadow: 0 24px 60px rgba(13,50,95,.14); }
  .employer-services article:hover::after { color: #fff; background: var(--color-blue); transform: rotate(8deg); }
  .employer-services article b { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 24px; border-radius: 7px; background: #edf6ff; }
  .employer-services article h3 { max-width: 200px; line-height: 1.15; }
  .employer-services article p { max-width: 290px; line-height: 1.55; }
</style>
