---
import MainLayout from '../layouts/MainLayout.astro';
import JobCard from '../components/JobCard.astro';
import GrowthBand from '../components/GrowthBand.astro';
import { jobs } from '../data/jobs';
---
<MainLayout title="D3MOON Jobs | IT Career Opportunities">
<main id="main-content">
<section class="page-hero"><div class="container"><div class="eyebrow light">CAREER OPPORTUNITIES</div><h1 class="display">Your next opportunity<br /><span>starts here.</span></h1><p>Explore IT opportunities and take the next step with focused career support from D3MOON.</p></div></section>
<section class="section jobs-section"><div class="container"><div class="jobs-intro"><div><div class="eyebrow">OPEN ROLES</div><h2 class="h2">Find your <span class="gradient-text">next move.</span></h2></div><p class="lead">We publish verified opportunities as they become available. In the meantime, share your profile and we will keep you in mind for relevant roles.</p></div>{jobs.length > 0 ? <div class="job-grid">{jobs.map(job => <JobCard job={job} />)}</div> : <div class="jobs-empty"><span aria-hidden="true">01</span><div><h3>No current openings</h3><p>We do not have verified roles published right now. Start a conversation and our team can help you plan your next move.</p><a class="btn btn-primary" href="/contact">Share your profile <span>→</span></a></div></div>}</div></section>
<section class="section application-section"><div class="container application-grid"><div><div class="eyebrow">CANDIDATE APPLICATION</div><h2 class="h2">Ready to make your <span class="gradient-text">move?</span></h2><p class="lead">Share your profile and the role you're interested in. This form is prepared for secure resume submission and email/API integration.</p><div class="application-points"><span>✓ Resume-ready application</span><span>✓ Career-focused conversations</span><span>✓ Simple, mobile-friendly process</span></div></div><form class="card form" data-form="application" data-email="info@d3moon.com" enctype="multipart/form-data"><div class="form-row"><label>Name *<input name="name" required /></label><label>Email *<input type="email" name="email" required /></label></div><div class="form-row"><label>Phone *<input name="phone" required /></label><label>Position *<input name="position" required /></label></div><div class="form-row"><label>Experience<input name="experience" /></label><label>Current Location<input name="location" /></label></div><label>Resume *<input type="file" name="resume" accept=".pdf,.doc,.docx" required /></label><label>Message<textarea name="message"></textarea></label><button class="btn btn-primary" type="submit">Apply Now <span>→</span></button><p class="form-status" aria-live="polite"></p></form></div></section>
<GrowthBand eyebrow="MORE THAN A JOB" title="Build skills. Gain confidence. <span>Keep growing.</span>" text="For students and professionals, D3MOON focuses on practical training and clear guidance that turns ambition into action." href="/contact" cta="Talk to D3MOON" />
</main>
</MainLayout>
<script>
  const selectedPosition = new URLSearchParams(window.location.search).get('position');
  const positionField = document.querySelector<HTMLInputElement>('input[name="position"]');
  if (selectedPosition && positionField) positionField.value = selectedPosition;
  const formEmail = (import.meta.env.PUBLIC_FORM_EMAIL as string | undefined) || 'pasific.coc@gmail.com';
  const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined) || `https://formsubmit.co/ajax/${encodeURIComponent(formEmail)}`;
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const contactEmail = formEmail;
    const status = form.querySelector<HTMLElement>('.form-status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const resume = form.querySelector<HTMLInputElement>('input[name="resume"]')?.files?.[0];
      if (resume && (resume.size > 5 * 1024 * 1024 || !/\.(pdf|docx?)$/i.test(resume.name))) {
        if (status) { status.classList.add('error'); status.textContent = 'Please upload a PDF, DOC, or DOCX resume under 5 MB.'; }
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (!button) return;
      const original = button.innerHTML; button.disabled = true; button.textContent = 'Sending…';
      try {
        const payload = new FormData(form);
        payload.append('_subject', `D3MOON application from ${payload.get('name') || 'new candidate'}: ${payload.get('position') || 'Open application'}`);
        payload.append('_replyto', String(payload.get('email') || ''));
        payload.append('_honey', '');
        payload.append('_template', 'table');
        const response = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: payload });
        if (!response.ok) throw new Error('request-failed');
        const result = await response.json().catch(() => null);
        if (result?.success === false || result?.success === 'false') throw new Error(result?.message || 'service-rejected');
        form.reset(); if (status) { status.classList.remove('error'); status.textContent = 'Thank you! Your application has been submitted successfully.'; }
      } catch (error) { if (status) { status.classList.add('error'); status.textContent = String(error).includes('Activation') ? 'Please activate the FormSubmit email link sent to ' + contactEmail + ', then submit again.' : 'We could not submit your application. Please try again or email ' + contactEmail + '.'; } }
      finally { button.disabled = false; button.innerHTML = original; }
    });
  });
</script>
<style>.application-section{background:#fff}.application-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:75px;align-items:start}.application-points{display:grid;gap:12px;margin-top:28px;color:#41536d;font-weight:700;font-size:.9rem}.form{padding:30px;display:grid;gap:17px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-status{margin:0;color:var(--color-blue);font-size:.85rem;font-weight:700}.form-status.error{color:#b42318}.jobs-section{background:#f7fbff}.jobs-intro{display:grid;grid-template-columns:1fr .8fr;gap:60px;align-items:end}.jobs-intro .lead{margin:0}.job-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:45px}.career-band{position:relative;isolation:isolate;overflow:hidden;padding-block:clamp(70px,8vw,104px);background:linear-gradient(118deg,#041f4d 0%,#063d91 58%,#075fae 100%);color:#fff}.career-band::before{content:'';position:absolute;z-index:-1;inset:-30% -8% -40% 52%;border:1px solid rgba(69,215,228,.22);border-radius:50%;transform:rotate(-18deg)}.career-band::after{content:'';position:absolute;z-index:-1;width:320px;height:320px;right:7%;top:-160px;border-radius:50%;background:radial-gradient(circle,rgba(37,197,208,.2),transparent 68%)}.career-grid{position:relative;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(290px,.75fr);gap:65px;align-items:center;min-height:250px}.career-heading{max-width:620px}.career-heading .h2{margin-top:16px;font-size:clamp(2.3rem,4vw,3.6rem)}.career-grid .h2 span{color:#50dce3}.career-copy{max-width:420px;position:relative;z-index:1}.career-copy p{margin:0 0 25px;color:#d3e7fb;font-size:1rem;line-height:1.65}.career-copy .btn{box-shadow:0 12px 24px rgba(1,19,59,.22)}.career-visual{position:absolute;right:-18px;bottom:-10px;width:340px;height:210px;opacity:.52;pointer-events:none}.career-line{position:absolute;left:22px;right:5px;top:104px;height:1px;background:linear-gradient(90deg,transparent,#4ddce5 15%,#4ddce5 85%,transparent);transform:rotate(-12deg)}.career-node{position:absolute;display:grid;place-items:center;min-width:82px;padding:8px 12px;border:1px solid rgba(111,232,239,.65);border-radius:99px;color:#baf7f5;background:rgba(3,31,76,.7);font-size:.72rem;font-weight:800;letter-spacing:.04em}.node-one{left:4px;top:128px}.node-two{left:111px;top:76px}.node-three{right:0;top:22px;background:#36cbd4;color:#042d6d;border-color:#8df4f2}@media(max-width:900px){.career-grid{grid-template-columns:1fr;gap:25px}.career-copy{max-width:520px}.career-visual{right:-20px;bottom:-35px;opacity:.3}}@media(max-width:760px){.jobs-intro,.job-grid,.career-grid,.application-grid{grid-template-columns:1fr;gap:30px}.form-row{grid-template-columns:1fr}.career-band{padding-block:64px}.career-heading .h2{font-size:clamp(2.25rem,10vw,3.2rem)}.career-visual{position:relative;right:auto;bottom:auto;width:100%;height:135px;margin-top:-8px}.career-line{top:72px}.node-one{left:0;top:86px}.node-two{left:33%;top:51px}.node-three{right:0;top:16px}}
</style>
<style>
  .jobs-empty { display: grid; grid-template-columns: 58px minmax(0, 520px); gap: 24px; align-items: start; margin-top: 44px; padding: 32px; border: 1px dashed #a8c9e8; border-radius: 20px; background: rgba(255,255,255,.68); }
  .jobs-empty > span { display: grid; place-items: center; width: 42px; height: 30px; color: var(--color-blue); background: #eaf5ff; border-radius: 8px; font-size: .75rem; font-weight: 900; }
  .jobs-empty h3 { margin: 0 0 8px; font-size: 1.3rem; }
  .jobs-empty p { margin: 0 0 20px; color: var(--color-muted); }
  @media (max-width: 560px) { .jobs-empty { grid-template-columns: 1fr; gap: 16px; padding: 24px; } }
</style>
