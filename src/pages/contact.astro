---
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';
---
<MainLayout title="Contact D3MOON | Recruitment & Career Solutions">
<main id="main-content">
<section class="page-hero"><div class="container"><div class="eyebrow light">CONTACT D3MOON</div><h1 class="display">Let's talk about your<br /><span>next opportunity.</span></h1><p>Whether you're hiring, looking for a role or planning your career, start the conversation.</p></div></section>
<section class="section contact-section"><div class="container contact-grid"><div class="contact-copy"><div class="eyebrow">GET IN TOUCH</div><h2 class="h2">Let's start with <span class="gradient-text">a conversation.</span></h2><p class="lead">Tell us what you're looking for and we'll help you take the next step.</p><div class="contact-details">{site.email && <a href={`mailto:${site.email}`}><small>EMAIL</small><strong>{site.email}</strong></a>}{site.phone && <a href={`tel:${site.phone}`}><small>PHONE</small><strong>{site.phone}</strong></a>}{site.location && <div><small>LOCATION</small><strong>{site.location}</strong></div>}</div></div><form class="card form" data-form="contact" data-email={site.email}><div class="form-row"><label>Name *<input name="name" required /></label><label>Email *<input type="email" name="email" required /></label></div><div class="form-row"><label>Phone<input name="phone" /></label><label>I am a:<select name="type"><option>Job Seeker</option><option>Employer</option><option>Student</option><option>Other</option></select></label></div><label>Subject *<input name="subject" required /></label><label>Message *<textarea name="message" required></textarea></label><button class="btn btn-primary" type="submit">Send Message <span>→</span></button><p class="form-status" aria-live="polite"></p></form></div></section>
</main>
</MainLayout>
<script>
  const formEmail = (import.meta.env.PUBLIC_FORM_EMAIL as string | undefined) || 'pasific.coc@gmail.com';
  const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined) || `https://formsubmit.co/ajax/${encodeURIComponent(formEmail)}`;
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const contactEmail = formEmail;
    const status = form.querySelector<HTMLElement>('.form-status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (!button) return;
      const original = button.innerHTML; button.disabled = true; button.textContent = 'Sending…';
      try {
        const payload = new FormData(form);
        payload.append('_subject', `D3MOON enquiry from ${payload.get('name') || 'new contact'}: ${payload.get('subject') || 'General enquiry'}`);
        payload.append('_replyto', String(payload.get('email') || ''));
        payload.append('_honey', '');
        payload.append('_template', 'table');
        const response = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: payload });
        if (!response.ok) throw new Error('request-failed');
        const result = await response.json().catch(() => null);
        if (result?.success === false || result?.success === 'false') throw new Error(result?.message || 'service-rejected');
        form.reset(); if (status) { status.classList.remove('error'); status.textContent = 'Thank you! Your message has been sent. We will get back to you shortly.'; }
      } catch (error) { if (status) { status.classList.add('error'); status.textContent = String(error).includes('Activation') ? 'Please activate the FormSubmit email link sent to ' + contactEmail + ', then submit again.' : 'We could not send your message. Please try again or email ' + contactEmail + '.'; } }
      finally { button.disabled = false; button.innerHTML = original; }
    });
  });
</script>
<style>.contact-section{background:#f7fbff}.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;align-items:start}.contact-details{margin-top:38px;display:grid;gap:22px}.contact-details a,.contact-details div{display:grid;gap:4px}.contact-details small{font-size:.67rem;letter-spacing:.15em;color:var(--color-blue);font-weight:900}.contact-details strong{font-size:1.05rem}.form{padding:30px;display:grid;gap:17px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-status{margin:0;color:var(--color-blue);font-size:.85rem;font-weight:700}.form-status.error{color:#b42318}.form button:disabled{cursor:wait;opacity:.7}@media(max-width:760px){.contact-grid{grid-template-columns:1fr;gap:35px}}@media(max-width:560px){.form-row{grid-template-columns:1fr}}
</style>
