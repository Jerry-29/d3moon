---
import MainLayout from '../layouts/MainLayout.astro';
import { services } from '../data/site';
---
<MainLayout title="Services | D3MOON — HR Management, Digital HR, Recruitment, Training, Audit & Advisory" description="Full-service HR consulting and managed services: HR Management, Digital HR, Recruitment, Training, Process Optimization, Employee Lifecycle, Assessment & Audit, Contractual Staffing, Manpower Planning and Business Advisory.">
<main id="main-content">
  <section class="page-hero">
    <div class="container hero-inner">
      <div class="eyebrow light">OUR SERVICES</div>
      <h1 class="display">Comprehensive HR services — <br /><span>engineered for impact.</span></h1>
      <p>D3MOON is your trusted partner in navigating the complex landscape of Human Resources. Our team of experienced HR professionals is dedicated to helping businesses thrive by providing expert guidance and customized solutions.</p>
    </div>
  </section>

  <section class="section overview">
    <div class="container">
      <div class="section-heading center">
        <div class="eyebrow">HOW WE HELP</div>
        <h2 class="h2">Resolving the <span class="gradient-text">greatest business challenges</span> through HR.</h2>
        <p class="lead">Strategize, digitize, develop, assess and audit — across the full employee lifecycle and the processes that support it.</p>
      </div>
      <div class="overview-grid">
        {['Strategize','Digitize','Develop','Assess and Audit','Learning and Development','Employee Lifecycle','Automate','Contractual Staffing','Manpower Planning Process','Business Advisory','Recruitment Process','Onboarding Process','Framing Contracts','Training and Development','Employee Engagement','Compensation Structure & Benchmarking'].map((t, i) => (
          <div class="chip" style={`--i:${i * 40}ms`}>{t}</div>
        ))}
      </div>
    </div>
  </section>

  <section id="hr-management" class="section service-block">
    <div class="container two-col">
      <div>
        <div class="eyebrow">SERVICE 01</div>
        <h2 class="h2">HR Management — <span class="gradient-text">end-to-end, tailored to you.</span></h2>
        <p class="lead">From the foundational documents that define your people practice to the systems that keep performance and engagement on track, we deliver a complete HR management function sized to your organisation.</p>
      </div>
      <ul class="service-list">
        {services.hrManagement.map(item => (
          <li><span class="check">✓</span><div>{item}</div></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="digital-hr-services" class="section service-block alt">
    <div class="container two-col reverse">
      <div>
        <div class="eyebrow">SERVICE 02</div>
        <h2 class="h2">Digital HR Services — <span class="gradient-text">modern systems for modern teams.</span></h2>
        <p class="lead">Bring people data, workflows and recognition together with digital HR platforms that reduce friction and give leadership a clear view of the workforce.</p>
      </div>
      <div class="card-grid">
        {services.digitalHR.map(item => (
          <article class="feature-card">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0759b9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 4v4"/><path d="M16 4v4"/></svg>
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="recruitment-services" class="section service-block">
    <div class="container two-col">
      <div>
        <div class="eyebrow">SERVICE 03</div>
        <h2 class="h2">Recruitment Services — <span class="gradient-text">find the right fit, reliably.</span></h2>
        <p class="lead">Whether you need targeted executive search, flexible contract resources, or a fully outsourced recruitment function, we bring discipline and quality to every stage of hiring.</p>
      </div>
      <div class="card-grid">
        {services.recruitment.map(item => (
          <article class="feature-card">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0759b9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="training" class="section service-block alt">
    <div class="container two-col reverse">
      <div>
        <div class="eyebrow">SERVICE 04</div>
        <h2 class="h2">Training — <span class="gradient-text">up-skill every tier of your organisation.</span></h2>
        <p class="lead">Role-specific programmes for founders, senior executives, leaders and freshers — aligned to the decisions and capabilities each audience needs to succeed.</p>
      </div>
      <div class="training-cards">
        {services.training.map(item => (
          <article class="training-card">
            <small>{item.audience.toUpperCase()}</small>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="process-optimization" class="section extras">
    <div class="container">
      <div class="section-heading center">
        <div class="eyebrow">ADDITIONAL CAPABILITIES</div>
        <h2 class="h2">A complete operating system for <span class="gradient-text">your people function.</span></h2>
      </div>
      <div class="extras-grid">
        {[
          { t:'Process Optimization', d:'Strategize, digitize, develop and automate HR operations for efficiency and predictability.', i:'⚙' },
          { t:'Employee Lifecycle', d:'Design and run the full journey from hire to exit with consistency and care.', i:'⟲' },
          { t:'Assessment & Audit', d:'Comprehensive evaluation and audit facilitation of HR practices, data and documents.', i:'◉' },
          { t:'Contractual Staffing', d:'Flexible staffing that adapts to variable workloads and project requirements.', i:'▤' },
          { t:'Manpower Planning', d:'Forecast and align workforce capacity with business strategy and growth plans.', i:'▥' },
          { t:'Business Advisory', d:'Expert HR advisory tied directly to your organisational goals and growth.', i:'◆' },
          { t:'Employee Engagement', d:'Practices that check engagement levels, regulate them and enable retention.', i:'♥' },
          { t:'Compensation Benchmarking', d:'Structures and benchmarks that keep pay competitive, fair and sustainable.', i:'$' },
        ].map(c => (
          <article class="extra-card">
            <div class="ex-icon">{c.i}</div>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container">
      <div class="cta-inner">
        <div>
          <div class="eyebrow light">DISCUSS YOUR REQUIREMENTS</div>
          <h2>Not sure which services <span>fit your stage?</span></h2>
          <p>Share your priorities with us — we'll recommend a clear, scoped engagement aligned to your goals.</p>
        </div>
        <div class="actions">
          <a class="btn btn-white" href="/contact">Request a Consultation <b>→</b></a>
          <a class="btn cta-outline" href="/training">See Training Programmes</a>
        </div>
      </div>
    </div>
  </section>
</main>
</MainLayout>

<style>
.page-hero{
  padding:110px 0 100px;
  background:
    radial-gradient(circle at 15% 80%, rgba(167,223,255,.18), transparent 45%),
    linear-gradient(120deg,#063d91,#0759b9 62%,#0a89a7);
  color:#fff;position:relative;overflow:visible;
}
.page-hero::after{
  content:'';position:absolute;width:540px;height:540px;border-radius:50%;left:-200px;top:-260px;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(255,255,255,.018);
}
.hero-inner{position:relative;z-index:1}
.page-hero p{color:#d4e6fb;max-width:700px;font-size:1.08rem;line-height:1.65}
.page-hero .display span{color:#a7dfff}

.overview{background:#fff}
.section-heading.center{margin-inline:auto;text-align:center;max-width:780px}
.section-heading.center .lead{margin-inline:auto}
.section-heading .lead{margin-top:0}
.overview-grid{
  display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:44px;max-width:960px;margin-inline:auto;
}
.chip{
  padding:10px 18px;border-radius:999px;background:#f2f8ff;color:#0759b9;
  font-weight:800;font-size:.88rem;border:1px solid #dce9fb;
  animation: chip-rise .5s ease both;animation-delay:var(--i,0);
}
@keyframes chip-rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.service-block{background:#fff}
.service-block.alt{background:var(--color-soft)}
.two-col{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:start}
.two-col.reverse{direction:rtl}
.two-col.reverse > *{direction:ltr}
.service-list{list-style:none;padding:0;margin:0;display:grid;gap:12px}
.service-list li{
  display:grid;grid-template-columns:28px 1fr;gap:14px;align-items:start;
  padding:16px 18px;background:#fff;border:1px solid var(--color-line);border-radius:16px;
  transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease;
}
.service-list li:hover{border-color:#bcdaf6;box-shadow:0 14px 30px rgba(7,89,185,.08);transform:translateY(-2px)}
.check{
  display:grid;place-items:center;width:28px;height:28px;border-radius:9px;
  background:linear-gradient(135deg,#0759b9,#0a89a7);color:#fff;font-weight:900;font-size:.85rem;flex-shrink:0;
  box-shadow:0 8px 18px rgba(7,89,185,.22);
}
.service-list div{font-size:.95rem;line-height:1.5;color:#223a61;font-weight:650;padding-top:3px}

.card-grid{display:grid;gap:14px}
.feature-card{
  padding:26px 24px;border-radius:20px;background:#fff;border:1px solid var(--color-line);
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;position:relative;overflow:hidden;
}
.feature-card::after{
  content:'';position:absolute;width:200px;height:200px;right:-100px;bottom:-100px;border-radius:50%;
  background:radial-gradient(circle,rgba(7,89,185,.08),transparent 65%);transition:transform .3s ease;
}
.feature-card:hover{transform:translateY(-4px);box-shadow:0 22px 50px rgba(7,61,145,.1);border-color:#bcdaf6}
.feature-card:hover::after{transform:scale(1.15)}
.card-icon{
  width:44px;height:44px;border-radius:12px;background:#edf5ff;
  display:grid;place-items:center;margin-bottom:18px;position:relative;z-index:1;
  box-shadow:inset 0 0 0 1px rgba(7,89,185,.1);
}
.feature-card h3{font-size:1.12rem;margin:0 0 8px;letter-spacing:-.01em;position:relative;z-index:1}
.feature-card p{color:var(--color-muted);font-size:.9rem;line-height:1.6;margin:0;position:relative;z-index:1}

.training-cards{display:grid;gap:12px}
.training-card{
  padding:22px 22px;border-left:3px solid #0759b9;border-radius:0 16px 16px 0;
  background:#fff;border-top:1px solid var(--color-line);border-right:1px solid var(--color-line);border-bottom:1px solid var(--color-line);
  transition:transform .2s ease,box-shadow .2s ease;
}
.training-card:hover{transform:translateX(4px);box-shadow:0 16px 36px rgba(7,61,145,.08)}
.training-card small{font-size:.65rem;letter-spacing:.18em;color:#0759b9;font-weight:900}
.training-card h3{font-size:1.08rem;margin:8px 0 6px}
.training-card p{color:var(--color-muted);font-size:.88rem;line-height:1.6;margin:0}

.extras{background:#fff}
.extras-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:46px}
.extra-card{
  padding:26px 22px;border:1px solid var(--color-line);border-radius:20px;background:#fff;
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
}
.extra-card:hover{transform:translateY(-5px);border-color:#bcdaf6;box-shadow:0 22px 50px rgba(7,61,145,.1)}
.ex-icon{
  width:44px;height:44px;border-radius:12px;
  background:linear-gradient(135deg,#e7f1ff,#e3f5f7);
  display:grid;place-items:center;font-size:1.25rem;margin-bottom:18px;color:#0759b9;
}
.extra-card h3{font-size:1.06rem;margin:0 0 8px;letter-spacing:-.01em}
.extra-card p{color:var(--color-muted);font-size:.86rem;line-height:1.6;margin:0}

.final-cta{padding-top:20px}
.cta-inner{
  border-radius:30px;padding:56px 60px;color:#fff;
  background:linear-gradient(110deg,#063d91,#0759b9 58%,#0a89a7);
  display:flex;align-items:center;justify-content:space-between;gap:40px;overflow:visible;position:relative;
}
.cta-inner::after{content:'';position:absolute;width:360px;height:360px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-100px;bottom:-230px}
.cta-inner h2{font-size:clamp(1.8rem,3.6vw,3rem);line-height:1.05;letter-spacing:-.045em;margin:10px 0;position:relative;z-index:1}
.cta-inner h2 span{color:#a7dfff}
.cta-inner p{color:#c9dcee;margin:0;position:relative;z-index:1;max-width:520px}
.actions{display:flex;gap:12px;flex-wrap:wrap;position:relative;z-index:1}
.cta-outline{color:#fff;border-color:rgba(255,255,255,.38);background:transparent}
.cta-outline:hover{border-color:#fff;background:rgba(255,255,255,.08)}

@media(max-width:980px){
  .two-col,.two-col.reverse{grid-template-columns:1fr;gap:36px;direction:ltr}
  .extras-grid{grid-template-columns:1fr 1fr}
  .cta-inner{flex-direction:column;align-items:flex-start;padding:44px 32px}
}
@media(max-width:560px){
  .page-hero{padding:80px 0 72px}
  .extras-grid{grid-template-columns:1fr}
  .cta-inner{padding:38px 26px}
}
</style>
