---
import MainLayout from '../layouts/MainLayout.astro';
import { values } from '../data/site';
---
<MainLayout title="About D3MOON | Managed HR Services & Consulting" description="About D3MOON: dynamic, tailored HR solutions delivered with a customer-centered approach, expertise, integrity, qualified excellence and prompt responsiveness.">
<main id="main-content">
  <section class="page-hero">
    <div class="container hero-inner">
      <div class="eyebrow light">ABOUT D3MOON</div>
      <h1 class="display">HR partners committed to <br /><span>Process, Practice, Potency.</span></h1>
      <p>We specialise in delivering dynamic HR solutions, meticulously tailored to meet the ever-evolving needs of startups, mid-sized, and established companies alike.</p>
    </div>
  </section>

  <section class="section">
    <div class="container intro-grid">
      <div>
        <div class="eyebrow">WHO WE ARE</div>
        <h2 class="h2">Streamlining HR complexity. <span class="gradient-text">Building predictable excellence.</span></h2>
      </div>
      <div>
        <p class="lead">
          When businesses partner with us, they unlock a world of possibilities. We streamline the complexities of HR team assembly, paving the way for enhanced predictability and efficiency in their operations. Our team of seasoned HR specialists ensures a smooth journey, guiding each team member to excel in their roles with precision and expertise.
        </p>
        <p class="lead">
          Embrace a future where productivity soars, resources are optimised, and operational excellence becomes the norm. Businesses can confidently steer towards unparalleled success with D3MOON by their side.
        </p>
      </div>
    </div>
  </section>

  <section class="section mission">
    <div class="container mission-grid">
      <div class="mission-card">
        <span>OUR APPROACH</span>
        <h2>A client-first mindset. Process-led delivery. HR you can rely on.</h2>
      </div>
      <div>
        <div class="eyebrow">WHAT WE STAND FOR</div>
        <h2 class="h2">Five commitments that shape <span class="gradient-text">every engagement.</span></h2>
        <p class="lead">
          Our values are the foundation of every client relationship. They guide how we design solutions, how we communicate and the standard of delivery we hold ourselves accountable to.
        </p>
      </div>
    </div>
  </section>

  <section class="section values-full">
    <div class="container">
      <div class="values-grid">
        {values.map((v, i) => (
          <article class="value-article">
            <div class="value-head">
              <span class="value-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.title}</h3>
            </div>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section brand-banner">
    <div class="container banner-inner">
      <div>
        <div class="eyebrow light">THE D3MOON DIFFERENCE</div>
        <h2>From HR foundations to strategic workforce planning — we bring it all together.</h2>
      </div>
      <div class="actions">
        <a class="btn btn-white" href="/services">Explore Our Services <b>→</b></a>
        <a class="btn cta-outline" href="/contact">Start the Conversation</a>
      </div>
    </div>
  </section>
</main>
</MainLayout>

<style>
.page-hero{
  padding:110px 0 100px;
  background:
    radial-gradient(circle at 85% 20%, rgba(167,223,255,.18), transparent 45%),
    linear-gradient(120deg,#063d91,#0759b9 62%,#0a89a7);
  color:#fff;
  position:relative;overflow:visible;
}
.page-hero::after{
  content:'';position:absolute;width:540px;height:540px;border-radius:50%;right:-180px;top:-260px;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(255,255,255,.018);
}
.hero-inner{position:relative;z-index:1}
.page-hero p{color:#d4e6fb;max-width:640px;font-size:1.08rem;line-height:1.65}
.page-hero .display span{color:#a7dfff}

.intro-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px;align-items:start}
.intro-grid .lead{margin:0 0 16px}

.mission{background:#f4fafe}
.mission-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:start}
.mission-card{
  background:linear-gradient(130deg,#063d91,#0a4f91);
  color:#fff;border-radius:28px;padding:48px;min-height:300px;
  display:flex;flex-direction:column;justify-content:flex-end;
  position:relative;overflow:hidden;
}
.mission-card::before{
  content:'';position:absolute;right:-100px;top:-100px;width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle,rgba(167,223,255,.22),transparent 65%);
}
.mission-card span{color:#a7dfff;font-size:.72rem;letter-spacing:.15em;font-weight:850;position:relative;z-index:1}
.mission-card h2{font-size:2rem;line-height:1.12;margin:16px 0 0;letter-spacing:-.035em;position:relative;z-index:1}
.mission-grid .lead{margin-top:18px}

.values-full{background:#fff}
.values-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:10px}
.value-article{
  padding:38px 34px;border:1px solid var(--color-line);border-radius:22px;
  background:#fff;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;
  position:relative;overflow:hidden;
}
.value-article::before{
  content:'';position:absolute;inset:auto -20% -60% 45%;height:300px;
  background:radial-gradient(circle,rgba(7,89,185,.08),transparent 65%);
  pointer-events:none;transition:transform .3s ease;
}
.value-article:hover{transform:translateY(-4px);box-shadow:0 22px 55px rgba(7,61,145,.1);border-color:#c7dcfa}
.value-article:hover::before{transform:scale(1.1)}
.value-head{display:flex;align-items:center;gap:18px;margin-bottom:18px;position:relative;z-index:1}
.value-index{
  display:grid;place-items:center;width:46px;height:46px;border-radius:14px;
  background:linear-gradient(135deg,#063d91,#0759b9);color:#fff;font-weight:900;font-size:.82rem;letter-spacing:.08em;
  box-shadow:0 10px 22px rgba(7,89,185,.24);
}
.value-head h3{font-size:1.22rem;line-height:1.25;margin:0;letter-spacing:-.01em}
.value-article p{color:var(--color-muted);line-height:1.7;font-size:.95rem;margin:0;position:relative;z-index:1}

.brand-banner{padding-bottom:90px}
.banner-inner{
  border-radius:30px;padding:58px 60px;color:#fff;
  background:linear-gradient(110deg,#063d91,#0759b9 58%,#0a89a7);
  display:flex;align-items:center;justify-content:space-between;gap:40px;overflow:visible;position:relative;
}
.banner-inner::after{content:'';position:absolute;width:360px;height:360px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-100px;bottom:-230px}
.banner-inner h2{font-size:clamp(1.8rem,3.4vw,2.9rem);line-height:1.08;letter-spacing:-.04em;margin:12px 0 0;max-width:620px;position:relative;z-index:1}
.actions{display:flex;gap:12px;flex-wrap:wrap;position:relative;z-index:1}
.cta-outline{color:#fff;border-color:rgba(255,255,255,.38);background:transparent}
.cta-outline:hover{border-color:#fff;background:rgba(255,255,255,.08)}

@media(max-width:900px){
  .intro-grid,.mission-grid{grid-template-columns:1fr;gap:36px}
  .mission-card{min-height:240px;padding:36px}
  .values-grid{grid-template-columns:1fr}
  .banner-inner{flex-direction:column;align-items:flex-start;padding:44px 32px}
}
@media(max-width:560px){
  .page-hero{padding:80px 0 72px}
  .mission-card h2{font-size:1.6rem}
  .value-article{padding:28px 24px}
  .banner-inner{padding:38px 26px}
}
</style>
