---
import MainLayout from '../layouts/MainLayout.astro';
import { values } from '../data/site';
import GrowthBand from '../components/GrowthBand.astro';
---
<MainLayout title="About D3MOON | IT Recruitment & Training">
<main id="main-content">
  <section class="page-hero"><div class="container"><div class="eyebrow light">ABOUT D3MOON</div><h1 class="display">Empowering Talent.<br /><span>Enabling Growth.</span></h1><p>We connect people, skills and opportunities across the IT ecosystem.</p></div></section>
  <section class="section"><div class="container intro-grid"><div><div class="eyebrow">OUR STORY</div><h2 class="h2">People first. <span class="gradient-text">Opportunity next.</span></h2></div><div><p class="lead">D3MOON is a leading recruitment and training firm specializing in the placement of IT professionals and career growth trainings for students.</p><p class="lead">Our mission is to connect top talent with exceptional career opportunities in the IT industry and provide students with the necessary skills and knowledge to succeed in their careers. With a focus on personalized service and industry expertise, we strive to match the right candidates with the right positions, ensuring mutual success for both individuals and companies.</p><p class="lead">Our commitment to excellence and integrity drives our passion for recruitment and training, making us a trusted partner in the career advancement process.</p></div></div></section>
  <section class="section mission"><div class="container mission-grid"><div class="mission-card"><span>OUR MISSION</span><h2>Connect talent with opportunity. Build skills for the future.</h2></div><div><div class="eyebrow">OUR APPROACH</div><h2 class="h2">A bridge between <span class="gradient-text">ambition and action.</span></h2><p class="lead">We work across recruitment and training because career growth and business growth are connected. Understanding the person and the requirement is where the right journey begins.</p></div></div></section>
  <section class="section"><div class="container"><div class="eyebrow">WHAT WE STAND FOR</div><h2 class="h2">Values that shape <span class="gradient-text">every connection.</span></h2><div class="values">{values.map((v,i)=><article><b>0{i+1}</b><h3>{v[0]}</h3><p>{v[1]}</p></article>)}</div></div></section>
  <section class="section bridge"><div class="container"><div class="eyebrow light">THE D3MOON CONNECTION</div><h2 class="h2">One ecosystem. <span>Three paths.</span></h2><div class="bridge-flow"><div><small>CANDIDATES</small><strong>Discover</strong><span>Opportunities</span></div><div class="d3node">D3<br />MOON</div><div><small>EMPLOYERS</small><strong>Build</strong><span>Great teams</span></div></div><p>Students and professionals build skills and pursue opportunities while employers connect with the talent they need.</p></div></section>
  <GrowthBand eyebrow="BUILD WHAT IS NEXT" title="Let's build better careers <span>together.</span>" text="Whether you are growing a team or planning your next step, the right conversation can create momentum." href="/contact" cta="Start a conversation" steps={['People', 'Skills', 'Progress']} />
</main>
</MainLayout>
<style>
.page-hero{padding:100px 0 95px;background:linear-gradient(120deg,#071a38,#0b4d90 65%,#0b8e9d);color:#fff;position:relative;overflow:hidden}.page-hero::after{content:'';position:absolute;width:500px;height:500px;border-radius:50%;right:-160px;top:-240px;border:1px solid rgba(255,255,255,.13);box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(255,255,255,.018)}.page-hero p{color:#cbdcf0;max-width:600px;font-size:1.08rem}.page-hero .display span{color:#62dfeb}.intro-grid,.mission-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:100px}.intro-grid .lead{margin:0 0 15px}.mission{background:#f4f9fe}.mission-card{background:linear-gradient(130deg,#071a38,#0a4f91);color:#fff;border-radius:28px;padding:45px;min-height:300px;display:flex;flex-direction:column;justify-content:flex-end}.mission-card span{color:#65e1ec;font-size:.72rem;letter-spacing:.15em;font-weight:800}.mission-card h2{font-size:2rem;line-height:1.1;margin:15px 0 0}.values{display:grid;grid-template-columns:repeat(5,1fr);gap:0;border-top:1px solid var(--color-line);border-bottom:1px solid var(--color-line);margin-top:45px}.values article{padding:28px 20px;border-right:1px solid var(--color-line)}.values article:last-child{border-right:0}.values b{color:var(--color-blue);font-size:.76rem}.values h3{margin:22px 0 8px}.values p{margin:0;color:var(--color-muted);font-size:.84rem}.bridge{background:linear-gradient(120deg,#071a38,#0a4b87);color:#fff}.bridge .h2 span{color:#62dfeb}.bridge-flow{display:grid;grid-template-columns:1fr 160px 1fr;align-items:center;gap:30px;margin:45px 0}.bridge-flow>div:not(.d3node){border:1px solid rgba(255,255,255,.16);padding:30px;border-radius:20px;background:rgba(255,255,255,.05)}.bridge-flow small{display:block;color:#74e3ed;font-size:.68rem;font-weight:800;letter-spacing:.14em}.bridge-flow strong{display:block;font-size:1.5rem;margin-top:10px}.bridge-flow span{color:#a8bdd5}.d3node{width:130px;height:130px;border-radius:50%;background:linear-gradient(135deg,var(--color-blue),var(--color-cyan));display:grid;place-items:center;text-align:center;font-weight:900;line-height:1;color:#fff;box-shadow:0 0 50px rgba(42,207,220,.25)}.bridge p{color:#bdd1e6;max-width:720px}.simple-cta{text-align:center}.simple-cta .h2{max-width:650px;margin:0 auto 25px}@media(max-width:800px){.intro-grid,.mission-grid{grid-template-columns:1fr;gap:35px}.values{grid-template-columns:1fr 1fr}.values article:nth-child(2),.values article:nth-child(4){border-right:0}.values article{border-bottom:1px solid var(--color-line)}.bridge-flow{grid-template-columns:1fr}.d3node{margin:auto}}
@media(max-width:520px){.values{grid-template-columns:1fr}.values article{border-right:0}.values article:last-child{border-bottom:0}}
</style>
