---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { title: string; description?: string; }
const { title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.d3moon.com').toString();
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: 'https://www.d3moon.com',
  logo: 'https://www.d3moon.com/images/d3moon-logo-source.png',
  email: site.email,
  description: site.description,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.d3moon.com/images/hero-team.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.d3moon.com/images/hero-team.jpg" />
    <meta name="theme-color" content="#0759b9" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/images/d3moon-logo-source.png" type="image/png" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <div class="page-scrollbar" role="scrollbar" aria-label="Page scroll position" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
      <span class="page-scrollbar-thumb"></span>
    </div>
    <button class="back-to-top" type="button" aria-label="Back to top" title="Back to top">
      <span class="back-to-top-progress" aria-hidden="true"></span>
      <span class="back-to-top-label" aria-hidden="true">TOP</span>
    </button>
    <script>
      const backToTop = document.querySelector<HTMLButtonElement>('.back-to-top');
      const progress = document.querySelector<HTMLElement>('.back-to-top-progress');
      const scrollRail = document.querySelector<HTMLElement>('.page-scrollbar');
      const scrollThumb = document.querySelector<HTMLElement>('.page-scrollbar-thumb');
      let ticking = false;
      let dragging = false;

      const updateScrollRail = () => {
        if (!scrollRail || !scrollThumb) return;
        const viewport = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        const scrollable = Math.max(0, documentHeight - viewport);
        const railHeight = scrollRail.clientHeight;
        const thumbHeight = scrollable ? Math.max(44, (viewport / documentHeight) * railHeight) : railHeight;
        const maxTop = Math.max(0, railHeight - thumbHeight);
        const ratio = scrollable ? window.scrollY / scrollable : 0;
        scrollThumb.style.height = `${thumbHeight}px`;
        scrollThumb.style.transform = `translateY(${ratio * maxTop}px)`;
        scrollRail.classList.toggle('active', scrollable > 0);
        scrollRail.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
      };

      const scrollFromPointer = (clientY: number) => {
        if (!scrollRail || !scrollThumb) return;
        const bounds = scrollRail.getBoundingClientRect();
        const maxTop = Math.max(1, bounds.height - scrollThumb.offsetHeight);
        const top = Math.min(maxTop, Math.max(0, clientY - bounds.top - scrollThumb.offsetHeight / 2));
        const ratio = top / maxTop;
        window.scrollTo({ top: ratio * (document.documentElement.scrollHeight - window.innerHeight), behavior: 'auto' });
      };

      const updateBackToTop = () => {
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollProgress = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
        backToTop?.classList.toggle('visible', window.scrollY > 420);
        progress?.style.setProperty('--scroll-progress', `${Math.min(1, Math.max(0, scrollProgress)) * 360}deg`);
        updateScrollRail();
        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateBackToTop);
          ticking = true;
        }
      }, { passive: true });
      window.addEventListener('resize', updateBackToTop, { passive: true });
      updateBackToTop();

      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      scrollRail?.addEventListener('pointerdown', (event) => { dragging = true; scrollRail.setPointerCapture(event.pointerId); scrollFromPointer(event.clientY); });
      scrollRail?.addEventListener('pointermove', (event) => { if (dragging) scrollFromPointer(event.clientY); });
      scrollRail?.addEventListener('pointerup', () => { dragging = false; });
      scrollRail?.addEventListener('pointercancel', () => { dragging = false; });
      scrollRail?.addEventListener('keydown', (event) => { if (event.key === 'Home') window.scrollTo({ top: 0, behavior: 'smooth' }); if (event.key === 'End') window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' }); });
    </script>
  </body>
</html>

<style>
  .page-scrollbar { position: fixed; top: 10px; right: 5px; bottom: 10px; z-index: 110; width: 8px; padding: 0; border: 0; border-radius: 999px; background: rgba(7,93,204,.08); opacity: 0; pointer-events: none; transition: opacity .2s ease; cursor: pointer; touch-action: none; }
  .page-scrollbar.active { opacity: .9; pointer-events: auto; }
  .page-scrollbar:hover, .page-scrollbar:focus-visible { opacity: 1; outline: none; background: rgba(7,93,204,.14); }
  .page-scrollbar-thumb { position: absolute; top: 0; left: 0; width: 100%; min-height: 44px; border-radius: inherit; background: linear-gradient(180deg, var(--color-blue), var(--color-cyan)); box-shadow: 0 2px 8px rgba(7,61,145,.28); }
  .page-scrollbar-thumb::after { content: ''; position: absolute; inset: 8px 2px; border-radius: inherit; background: rgba(255,255,255,.3); }
  .back-to-top {
    --scroll-progress: 0deg;
    position: fixed;
    right: clamp(16px, 3vw, 34px);
    bottom: clamp(16px, 3vw, 30px);
    z-index: 90;
    display: grid;
    width: 52px;
    height: 52px;
    padding: 3px;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(145deg, var(--color-blue), var(--color-navy));
    box-shadow: 0 12px 26px rgba(5, 61, 145, .28);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px) scale(.88);
    transition: opacity .25s ease, visibility .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .back-to-top.visible { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0) scale(1); }
  .back-to-top:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 16px 32px rgba(5, 61, 145, .36); }
  .back-to-top:active { transform: translateY(-1px) scale(.98); }
  .back-to-top-progress { position: absolute; inset: 0; border-radius: inherit; background: conic-gradient(var(--color-cyan) var(--scroll-progress), rgba(255,255,255,.25) 0); mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px)); -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px)); }
  .back-to-top-label { position: relative; display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; background: rgba(255,255,255,.1); font-size: .58rem; font-weight: 900; letter-spacing: .1em; line-height: 1; }
  @media (prefers-reduced-motion: reduce) { .back-to-top { transition: none; } .back-to-top:hover { transform: scale(1.03); } }
  @media (max-width: 560px) { .page-scrollbar { right: 3px; width: 6px; }.back-to-top { width: 46px; height: 46px; } }
</style>
